// prisma/schema.prisma
//
// البنية دي بتعكس بالظبط اللي اتفقنا عليه:
// User واحد (انت) -> عنده كذا Workspace (زي "الفايلات") -> كل Workspace
// مربوط بحسابات إعلانية مختارة من Google Ads / Meta، بالإضافة لملفات Excel مرفوعة.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // ملاحظة: لا نضع directUrl هنا عمداً. Prisma يرفض المخطط بالكامل إذا
  // كان متغيّر البيئة المشار إليه غير مضبوط - أي أن إضافته "احتياطاً"
  // كانت ستُفشل بناء كل من لم يضبط DIRECT_URL. بدلاً من ذلك يتولّى
  // scripts/db-push-safe.mjs تمرير الاتصال المباشر عند توفّره فقط.
}

generator client {
  provider = "prisma-client-js"
}

// ==================== حماية عامة من تكرار معالجة الـ Webhooks ====================
// أي مصدر webhook (سلة، شوبيفاي، إيزي أوردرز، إلخ) بيسجل هنا معرف الحدث
// اللي عالجه فعلاً، قبل ما يعالجه - لو نفس الحدث وصل تاني (retry شائع جداً
// من كل مزودي الـ webhooks)، بنتجاهله بدل ما نعالجه مرتين ونضاعف البيانات.

model ProcessedWebhookEvent {
  id              String   @id @default(cuid())
  source          String // "SALLA" | "SHOPIFY" | "WHATSAPP" ...
  externalEventId String // معرف الحدث من عند المصدر نفسه (order id مثلاً)
  processedAt     DateTime @default(now())

  /// 🔴 **صاحبُ الحدث - وبدونه كان تاجرٌ يبتلع طلبات تاجرٍ آخر.**
  ///
  /// كان المفتاح `[source, externalEventId]` وحده: عامّاً على القاعدة
  /// كلّها. وأرقام الطلبات ليست عالمية - ووكومرس برنامجٌ يُنصَّب على خادم
  /// التاجر نفسه، وكلّ تنصيبٍ يبدأ الترقيم من واحد ولا شيء ينسّق بينها.
  /// فأوّل تاجرين يبيعان في اليوم نفسه: طلب «1001» عند الأوّل يُسجَّل،
  /// وطلب «1001» عند الثاني يُقرأ **مكرَّراً فيُهمَل بصمت** - لا خطأ ولا
  /// سجلّ، إيرادٌ ناقصٌ في تقرير لا يشكو.
  ///
  /// والنطاق هو **الربط** لا مساحة العمل، ليصحّ كذلك لمن يملك متجرين
  /// على المنصّة نفسها داخل مساحةٍ واحدة.
  ///
  /// يبقى فارغاً لمصادر معرّفاتُها عالمية بطبيعتها (معرّف عملية Paymob،
  /// ومعرّف ليد ميتا) - فلا نطاق لها ولا حاجة إليه.
  scopeId String @default("")

  @@unique([source, scopeId, externalEventId])
}

// ==================== المستخدمين ====================

model User {
  id                          String             @id @default(cuid())
  email                       String             @unique
  // اختياري دلوقتي - حساب مسجّل بجوجل/فيسبوك مالوش باسورد أصلاً، مش
  // كل المستخدمين لازم يبقى عندهم واحد
  passwordHash                String?
  name                        String?
  // صورة الملف الشخصي - بتيجي مباشرة من جوجل/فيسبوك وقت تسجيل الدخول
  // بيهم، مش رفع يدوي
  avatarUrl                   String?
  // معرفات تسجيل الدخول - مختلفين تماماً عن ConnectedPlatform (اللي ده
  // لربط حساب إعلاني للإدارة، ده لتسجيل الدخول للمنتج نفسه - نطاق
  // صلاحيات مختلف كلياً: بريد واسم بس، مش إدارة إعلانات)
  googleLoginId               String?            @unique
  facebookLoginId             String?            @unique
  isAdmin                     Boolean            @default(false) // صاحب المنتج (انت) - مش عميل عادي، بيشوف لوحة تحكم شاملة
  isSuspended                 Boolean            @default(false) // تعليق مؤقت من الأدمن - الحساب موجود، بس مش يقدر يستخدم المنتج
  lastLoginAt                 DateTime?
  // آخر مرة المستخدم فعلياً فتح التطبيق (مش بس سجّل دخول - ممكن يفضل
  // مسجّل دخول لمدة الجلسة كلها 30 يوم من غير ما يفتح) - أساس تنبيه
  // "معملتش فتح من فترة"
  lastActiveAt                DateTime?
  // آخر مرة اتبعتله تنبيه "معملتش فتح" - عشان منكررهوش كل يوم لو فضل
  // مش فاتح أصلاً (cooldown 7 أيام)
  lastInactivityPushAt        DateTime?
  pushSubscriptions           PushSubscription[]
  // تتبع جولة التعريف بالمنتج (Onboarding Tour) - null = لسه معملهاش،
  // بنعتمد على "أيام استخدام فعلية" مش أيام تقويمية عادية (لو المستخدم
  // فتح مرة واحدة وسابه أسبوعين، مينفعش الجولة تختفي من غير ما يشوفها)
  onboardingStep              Int                @default(0) // فين وقف - 0 = لسه ما بدأش
  onboardingCompleted         Boolean            @default(false)
  onboardingCelebrationShown  Boolean            @default(false) // عشان الشاشة الاحتفالية تظهر مرة واحدة بس، مش كل مرة يفتح الداشبورد
  onboardingDismissed         Boolean            @default(false) // دس Skip نهائي - مختلف عن "خلص" الجولة كاملة
  onboardingActiveDaysSeen    Int                @default(0) // كام يوم استخدام فعلي شاف فيهم الجولة لسه متاحة - أساس الاختفاء بعد 7-10 أيام
  // إبطال الجلسات (Fix B من الاختبار العدائي): أي توكن اتصدر قبل التاريخ
  // ده بيترفض، حتى لو لسه ما انتهتش صلاحيته الطبيعية. بيتحدّث عند تسجيل
  // الخروج - يبطّل كل التوكنات القديمة فوراً، مش بس يمسح الكوكي المحلي
  sessionInvalidatedAt        DateTime?
  emailVerified               Boolean            @default(false)
  verificationToken           String?            @unique
  verificationTokenExpiresAt  DateTime?
  resetPasswordToken          String?            @unique
  resetPasswordTokenExpiresAt DateTime?
  // التحقق بخطوتين (TOTP) - اختياري، المستخدم يفعّله بنفسه من الإعدادات
  mfaSecret                   String? // مشفّر بنفس آلية توكنات OAuth (AES-256-GCM)
  mfaEnabled                  Boolean            @default(false)
  mfaBackupCodes              MfaBackupCode[]
  trustedDevices              TrustedDevice[]
  mfaLastUsedCode             String? // آخر كود نجح - يمنع إعادة استخدام نفس الكود مرتين (Replay)

  /// 🔴 **المخرج الثالث لمن فقد هاتفه وورقته معاً.**
  ///
  /// التحقّق بخطوتين مخرجان: تطبيق المصادقة، وأكواد الاسترجاع المطبوعة.
  /// ومن ضاع هاتفه ولم يحفظ الورقة يبقى مقفولاً خارج حسابه بلا حيلة -
  /// وهي نهايةٌ يقع فيها مستخدمون حقيقيون، لا حالةٌ نظرية.
  ///
  /// والبريد ليس تخفيفاً للأمان: المنتج **يثق به أصلاً** لاستعادة كلمة
  /// المرور، فمن يملك الصندوق يملك الحساب على أيّ حال. وهو أضعف من
  /// TOTP بلا شكّ، فلا يُعرَض بديلاً بل مخرجاً بعد فشل الاثنين، ولا
  /// يُرسَل إلّا بعد إثبات كلمة المرور (رمز الانتظار).
  mfaEmailCodeHash      String?
  mfaEmailCodeExpiresAt DateTime?
  /// لمنع إغراق صندوق المستخدم بالطلب المتكرّر
  mfaEmailCodeSentAt    DateTime?
  // حماية من محاولات الدخول المتكررة (Brute Force) - قفل مؤقت بعد محاولات فاشلة كتير
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime  @default(now())

  // ==================== الاشتراك والدفع (Paymob) ====================
  // على مستوى User مش Workspace - المنتج "اشتراك لمستخدم واحد بمساحات
  // عمل عامة" (قرار منتج سابق)، يعني اشتراك واحد لكل مستخدم بغض النظر
  // عن عدد الـWorkspaces بتاعته.
  //
  // ملاحظة معمارية: Paymob مالهاش مفهوم "Customer/Subscription" جاهز
  // زي Stripe بالظبط - بتشتغل بمنطق "نية دفع" (Intention) + "توكن كارت
  // محفوظ" نعيد استخدامه شهرياً للتجديد. subscriptionReferenceId هنا
  // معناها "معرف الاشتراك عندنا احنا"، مش معرف من Paymob نفسها.
  paymobCustomerId    String?   @unique // لو Paymob بترجع معرف عميل موحّد - يتأكد بأول اتصال حقيقي
  savedCardToken      String? // توكن الكارت المحفوظ - يُستخدم لتحصيل التجديد الشهري تلقائياً
  /// وصفُ الكارت المحفوظ للعرض وحده ("Visa ····1111") - لا سرّ فيه.
  /// يُعرَض للمشترك ليعرف أيّ بطاقةٍ ستُحصَّل عند التجديد.
  savedCardBrand      String?
  savedCardLast4      String?
  /// دورةُ الاشتراك المخزَّنة على الحساب - **يحتاجها التجديد التلقائيّ**.
  ///
  /// 🔴 كانت الدورة (شهريّ/سنويّ) على `PaymentIntent` وحدها، فمهمّةُ التجديد
  /// لا تعرف كم تُحصّل ولا كم تمدّد. تُخزَّن هنا عند كلّ دفعةٍ ناجحة.
  subscriptionCycle   String? // "monthly" | "yearly"
  /// آخر محاولةِ تجديدٍ تلقائيّ وعددُها - كي لا تُطرَق بطاقةٌ فاشلة كلّ يوم.
  lastRenewalAttempt  DateTime?
  renewalAttemptCount Int       @default(0)

  /// بلد الفوترة (ISO-2) - **يحدّد قائمة السعر وحدها، ولا يقيّد الدفع إطلاقاً.**
  ///
  /// 🔴 كانت قائمة السعر تُشتقّ من `Workspace.dataCurrency` - عملة الحساب
  /// الإعلانيّ. وهي غير قابلة للتعديل، ولا علاقة لها بمن يدفع: صاحب حسابٍ
  /// بالدولار كان **يُرفَض دفعُه كلّياً** لأنّ بوّابة الدفع تقبل الجنيه وحده.
  /// والاشتراك أصلاً على هذا الجدول لا على مساحة العمل، فاشتقاقُه من مساحةٍ
  /// كان خلطاً بين شيئين لا يجمعهما شيء.
  ///
  /// يُضبَط مرّة عند التسجيل من `x-vercel-ip-country`، ثمّ **لا يعدّله
  /// المستخدم** - وهذا ما يُبقي ثغرة B-1 مغلقة (كان يختار عملته فيختار سعره).
  /// المالك وحده يعدّله من لوحته.
  billingCountry     String?
  subscriptionStatus SubscriptionStatus @default(NONE)
  subscriptionPlan   String? // "starter" | "pro" | إلخ - اسم الخطة، مش الـ price id
  /// رصيد كريدت الذكاء الاصطناعي المشترى - منفصل عن مخصّص الباقة
  /// الشهري. المخصّص يتجدّد، والمشترى يبقى حتى يُستهلك.
  aiCreditsPurchased Int                @default(0)

  /// حدودٌ تعلو حدود الباقة لهذا المشترك وحده - اتّفاقٌ خاصّ لا باقة معلَنة.
  ///
  /// 🔴 **الفجوة التي سدّها هذا الحقل:** أكبر باقة تمنح خمس عشرة مساحة عمل
  /// وخمسة عشر حساباً لكلّ منصّة. ووكالةٌ بخمسين عميلاً تتجاوزهما، فكان
  /// الرفض يُحسب لها ترقيةً **غير موجودة** فيرجع `null` - أي أنّ الرسالة
  /// تقول «رقِّ باقتك» ولا شيء فوقها. طريقٌ مسدود لأكبر عميل محتمَل.
  ///
  /// شكلها `{ "workspaces": 60, "adAccounts": 60 }` - المفاتيح أسماء حقول
  /// `PlanLimits`، وما لا يُذكر يبقى على قيمة الباقة. تُضبط يدوياً بعد
  /// الاتّفاق، فلا تُعلَن كباقةٍ لا يعرف أحد سعرها.
  planLimitOverrides Json?

  /// حدّ معدّل خاصّ بمربّع السؤال، منفصل عن حدّ زرّ التحديث.
  ///
  /// **الرصيد الشهريّ مشترك** (نداء Claude واحد بتكلفة واحدة، فلا معنى
  /// لجيبين)، **والحدّ الساعيّ منفصل**: حدّ الزرّ مرّتان في الساعة وهو
  /// مناسبٌ لزرٍّ يُعيد تحليلاً كاملاً، وقاتلٌ لمحادثة تُطرح فيها ثلاثة
  /// أسئلة متتابعة. عدّاد واحد كان سيجعل سؤالين يُجمّدان الزرّ ساعةً.
  aiChatHourlyCount Int      @default(0)
  aiChatHourlyReset DateTime @default(now())

  // ==== قياس الاستهلاك الشهريّ (سقف الإنفاق والتحويلات) ====
  //
  // **يُقاس مرّةً في اليوم ويُخزَّن، لا يُحسب عند كلّ فتحة صفحة:** القياس
  // يجمع شهراً كاملاً عبر كلّ مساحات المستخدم؛ تشغيله مع كلّ طلب يجعل كلّ
  // صفحة في المنتج تدفع ثمن فحصٍ لا يتغيّر أكثر من مرّة يومياً. هذا ما
  // تفعله أنظمة القياس في أيّ SaaS: وظيفةُ قياس، لا استعلامٌ حيّ.
  //
  // لا نحتفظ بالفترات السابقة: القرار يخصّ الفترة الجارية وحدها، وأوّل
  // يوم في شهر جديد يصفّر الحقول كلّها.
  /// أوّل يوم في الفترة المقيسة. اختلافه عن الشهر الجاري = صفّر وابدأ.
  usagePeriodStart  DateTime?
  /// الإنفاق المُدار هذا الشهر بالدولار - وحدة الحدّ في كتالوج الباقات
  usageSpendUsd     Float           @default(0)
  usageVerifiedConv Int             @default(0)
  /// تنبيه الاقتراب (٨٠٪) - مرّة واحدة لكلّ فترة، فلا يتحوّل إلى إزعاج يوميّ
  usageWarnedAt     DateTime?
  /// إشعار توقّف المزامنة - مرّة واحدة لكلّ فترة كذلك
  usageBlockedAt    DateTime?
  paymentIntents    PaymentIntent[]
  currentPeriodEnd  DateTime?
  // مبدأ عام بغض النظر عن مزوّد الدفع: لما مستخدم يلغي، منقفلش الوصول
  // فوراً - بنسيبه شغال لحد نهاية الفترة اللي دفعها فعلاً، ده أعدل تجربة
  cancelAtPeriodEnd Boolean         @default(false)

  workspaces         Workspace[]
  // التوكنات دي على مستوى المستخدم مش على مستوى الـ Workspace،
  // لأن عندك MCC واحد بيشوف كل العملاء - تربط مرة واحدة بس
  connectedPlatforms ConnectedPlatform[]
  savedViews         SavedView[]
  feedback           Feedback[]

  // ==== تفضيلات الواجهة (عامة على كل الحساب) ====
  themeColor      String @default("blue") // blue | purple | orange | sky | red ...
  themeMode       String @default("light") // light | dark - الوضع الفاتح هو الأساسي
  preferredLocale String @default("en") // ar | en - الإنجليزية افتراضٌ لكل بلد، والعربية اختيارٌ صريح من الإعدادات
  timezone        String @default("Asia/Riyadh") // لعرض الأوقات والتواريخ بتوقيت المستخدم نفسه

  // ==== الملف الشخصي ====
  // افتراضي: أيقونة من مجموعة مصممة تناسب هوية النظام (كود/AI/أتمتة)،
  // أو صورة مرفوعة لو المستخدم حب - افتراضي واحد بس مش الاتنين مع بعض
  avatarIcon     String? @default("bot") // "bot" | "cpu" | "sparkles" | "terminal" | "brain" | "zap"
  avatarImageUrl String? @db.Text // لو رفع صورة فعلية، بتلغي الأيقونة الافتراضية

  // من سؤال الـ Onboarding "بتدير كام عميل؟" - بيفيد في تخصيص الافتراضيات
  // لاحقاً (وكيل واحد بحجم أعمال مختلف عن وكالة بـ50 عميل)
  businessScale String? // "solo" | "1_5" | "5_20" | "20_50" | "50_plus" - عدد العملاء الحاليين

  // بيانات التسجيل الإضافية
  username       String?   @unique // اسم مستخدم فريد يختاره العميل
  companyName    String? // اسم الشركة (اختياري)
  gender         String? // "male" | "female"
  /// تاريخ الميلاد - اختياري، يُستخدم لتقسيم شرائح المستخدمين لا للتحقّق
  birthDate      DateTime?
  howHeard       String? // من أين سمع عن AdLoop
  referralSource String? // كود/مصدر إحالة (اختياري)
  country        String? // الدولة
  adSpendMonthly String? // نطاق الإنفاق الإعلاني الشهري

  // ==== حد استخدام الـ AI - على مستوى الحساب ككل (مش لكل Workspace لوحده) ====
  // ده مهم جداً: لو الحد كان لكل Workspace، حد يقدر يعمل عشرات الـ Workspaces
  // الفاضية ويستهلك رصيد مضاعف. الحد هنا مجمّع على كل الحساب.
  // الحد اليدوي 120/شهر + استدعاء تلقائي واحد يومياً (30/شهر) = 150 إجمالاً (5/يوم)
  aiRefreshMonthlyCount    Int                 @default(0)
  aiRefreshMonthlyReset    DateTime            @default(now())
  aiRefreshHourlyCount     Int                 @default(0)
  aiRefreshHourlyReset     DateTime            @default(now())
  // سقف تكلفة Claude API - كانت الحاجتين دول من غير أي حد أقصى خالص
  // (ثغرة مالية حقيقية مفتوحة). أضيفت عشان نضمن سقف $4/شهر لكل مشترك
  // (راجع docs/claude-api-usage-map.md للحساب الكامل)
  imageQualityMonthlyCount Int                 @default(0)
  imageQualityMonthlyReset DateTime            @default(now())
  imageQualityHourlyCount  Int                 @default(0)
  imageQualityHourlyReset  DateTime            @default(now())
  siteScanMonthlyCount     Int                 @default(0)
  siteScanMonthlyReset     DateTime            @default(now())
  siteScanHourlyCount      Int                 @default(0)
  siteScanHourlyReset      DateTime            @default(now())
  marketingEmails          MarketingEmailLog[]
  /// إيقاف رسائل التسويق. التنبيهات التشغيلية لا تتأثّر - إيقافها يتمّ
  /// من تفضيلات مساحة العمل. الخلط بينهما يعني أنّ من لا يريد التسويق
  /// يفقد تنبيه «إعلان يُنفق بلا عميل» أيضاً.
  marketingOptOut          Boolean             @default(false)
  /// لحظة الموافقة على الشروط وسياسة الخصوصية.
  /// تاريخ لا `Boolean`: عند أيّ نزاع أو تدقيق، السؤال «متى وافق» لا
  /// «هل وافق». ويسمح لاحقاً بمطالبة من وافق على نسخة قديمة بالموافقة
  /// على المحدَّثة.
  acceptedTermsAt          DateTime?
  agentChats               AgentChat[]
  /// المحادثات المعيَّنة لهذا الحساب في صندوق الدعم.
  assignedThreads          SupportThread[]     @relation("SupportAssignee")

  // ==================== لوحة المالك (Admin Panel) ====================
  //
  // الحقول دي كلها **إضافية بحتة**: كل واحد فيها إمّا اختياري أو له
  // قيمة افتراضية، فالحساب اللي مالوش أي تدخّل إداريّ بيتصرّف بالظبط
  // زي ما كان قبل ما اللوحة تتبني.

  /// دور الأدمن. null + isAdmin=true → OWNER (راجع lib/adminRole.ts).
  adminRole AdminRole?

  /// شقيق `planLimitOverrides` للحقول المنطقية/التعدادية في `PlanLimits`
  /// (`mcp`, `scheduledReports`, `scaleKill`, `conversionSync`). فُصل عنه
  /// لأنّ التحقّق مختلف: ذاك أرقام، وده منطقيّات وقيم من قوائم مغلقة -
  /// خلطهما كان هيجبر `parseOverrides` على فحصين في دالة واحدة.
  featureOverrides Json?

  /// سعر تجديد خاصّ بهذا الحساب بالسنت - اتّفاق أو خصم دائم، بدل اختراع
  /// باقة جديدة في الكتالوج لعميل واحد. `null` = سعر الباقة المعلَن.
  /// يُقرأ في مسار الدفع قبل الرجوع إلى `PLAN_BY_KEY`. القيمة **شهرية**،
  /// والسنويّ بيتحسب منها بنفس معادلة الكتالوج (`YEARLY_MONTHS_CHARGED`).
  customPriceOverrideCents Int?

  /// 🔴 **العملة إجبارية مع السعر المخصّص، مش تفصيلة.** الرقم لوحده
  /// بلا عملة كان هيتطبّق على أي عملة يقع عليها الحساب وقت الدفع، و899
  /// جنيه مصري و899 دولار رقمان مختلفان بخمسين ضعفاً. لو العملة
  /// اتغيّرت (اتغيّرت عملة مساحة العمل مثلاً)، مسار الدفع بيتجاهل
  /// السعر المخصّص ويرجع لسعر الكتالوج - رجوع لسعر معلن أأمن من تحصيل
  /// رقم بعملة مالهاش علاقة.
  customPriceCurrency String?

  /// تمييز يدويّ بحكم المالك، لا استنتاج خوارزميّ. القائمة المحسوبة
  /// (الأعلى إيراداً) مجرّد اقتراح يظهر جنبه، مش بديل عنه.
  isVip Boolean @default(false)

  /// ملاحظة داخلية عن الحساب - لا تظهر للعميل أبداً
  adminNotes String?  @db.Text
  /// وسوم قصيرة للتصنيف الداخليّ ("وكالة"، "تجربة"، "متابعة")
  adminTags  String[]

  subscriptionEvents SubscriptionEvent[]
  adminEmails        AdminEmailLog[]
  activityDays       UserActivityDay[]
  featureEvents      FeatureEvent[]
  usageSnapshots     AdminUsageSnapshot[]
}

// ربط المنصة على مستوى المستخدم (مرة واحدة لكل منصة)
// ==================== منح الوصول إلى المنصّات الإعلانية ====================
//
// **الصفّ هنا ليس حساباً إعلانياً، بل بابٌ إليه.** منحة جوجل عبر حساب
// إدارة (MCC) تصل إلى عشرات الحسابات بتوكن واحد، ولذلك يُنسَب الحساب
// إلى `CampaignLink.externalAccountId` لا إلى هذا الجدول.
//
// 🔴 **سقط القيد `@@unique([userId, platform])`** الذي كان يحصر المشترك
// في تسجيل دخولٍ واحدٍ لكلّ منصّة. وهو يكفي معلناً يدير حسابه، ويمنع
// الوكالة التي أعطاها عميلان صلاحيةً من حسابين منفصلين: ربطُ الثاني كان
// **يستبدل** الأوّل بصمت (`upsert` على المفتاح نفسه)، فتتوقّف مزامنة
// العميل الأوّل بلا رسالةٍ ولا أثر.
//
// وسقوطُه يعني أنّ «أوّل منحة لهذه المنصّة» لم يعد جواباً صحيحاً - وهو ما
// يحسمه `lib/platformConnections.ts` في موضعٍ واحد.
model ConnectedPlatform {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform         Platform
  accessToken      String    @db.Text
  refreshToken     String?   @db.Text
  // للـ Google Ads: الـ MCC id بتاعك (login-customer-id)
  managerAccountId String?
  expiresAt        DateTime?
  connectedAt      DateTime  @default(now())

  // اسمٌ يميّز المنحة حين تتعدّد («حساب عميل أ»). تسجيلا دخولٍ
  // لمنصّةٍ واحدة لا يفرّقهما شيءٌ في الواجهة بغيره - كلاهما «جوجل».
  label    String?
  accounts ConnectedAccount[]

  @@index([userId, platform])
}

// ==================== الحسابات التي تصلها المنحة ====================
//
// تُكتَب من `available-campaigns` وحده - وهو ينادي المنصّة ويعدّد
// حساباتها بالفعل قبل أن يعرضها للاختيار. **فالحفظ هنا لا يكلّف
// نداءً واحداً إضافياً**، وهو ما يجعل السجلّ يستحقّ وجوده: بدونه لا
// تعرف الواجهة ما الذي يصله كلّ تسجيل دخول، فيرى المشترك «جوجل»
// و«جوجل» ولا يعرف أيّهما حساب أيّ عميل.
model ConnectedAccount {
  id                String            @id @default(cuid())
  connectionId      String
  connection        ConnectedPlatform @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform          Platform
  externalAccountId String
  name              String?
  // آخر مرّة رأت المنصّة هذا الحساب ضمن ما تصله المنحة. حسابٌ لم
  // يُرَ منذ مدّة يعني على الأرجح أنّ الصلاحية سُحبت - وهي إشارةٌ
  // نعرضها ولا نحذف بها، لأنّ انقطاع نداءٍ واحد ليس سحباً للصلاحية.
  lastSeenAt        DateTime          @default(now())

  @@unique([connectionId, externalAccountId])
  @@index([platform, externalAccountId])
}

// ==================== أكواد استرجاع التحقّق بخطوتين ====================
//
// 🔴 **الفجوة التي سدّها هذا الجدول:** كان من يفعّل التحقّق بخطوتين ثمّ
// يفقد هاتفه **يُقفَل خارج حسابه نهائياً** - يعرف بريده وكلمة مروره ولا
// يملك الكود، ولا مسارَ في المنتج يعيده. الحلُّ الوحيد تدخّلٌ يدويّ في
// قاعدة البيانات، وهو ما لا يصلح لمنتجٍ له مشتركون.
//
// **مخزَّنةٌ مجزّأةً (hash) لا نصّاً**، كما كلمات المرور: من يقرأ الجدول
// لا يستطيع الدخول به. ولذلك تُعرَض مرّةً واحدةً عند توليدها - لا يمكننا
// إظهارُها بعدها لأنّنا لا نملكها.
//
// ولكلّ كودٍ استعمالٌ واحد: يُحرَق بأوّل استخدام، فسرقةُ كودٍ مستعملٍ
// لا تفيد شيئاً.
// ملاحظة: `User.planLimitOverrides` أعلاه هو المخرج الوحيد لمن لا تسعه
// أكبر باقة - راجع `lib/entitlements.ts`.

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// 🔴 **المجموعة الجديدة لا تُبطل القديمة حتى تُؤكَّد.**
  ///
  /// كانت إعادة التوليد تحذف القديمة وتكتب الجديدة في معاملةٍ واحدة.
  /// فمن ضغط «توليد» ثمّ أُغلق المتصفّح، أو نفدت بطّاريته، أو أغلق
  /// اللوحة قبل أن ينسخ - يخرج بلا ورقةٍ قديمة ولا جديدة. أوراقه
  /// الاحتياطية ضاعت في ثانية، ولا يكتشف ذلك إلّا يوم يفقد هاتفه.
  ///
  /// فتُكتب الجديدة **معلّقة**، وتبقى القديمة عاملةً إلى أن يقرّ أنّه
  /// حفظها - وعندها وحدها تُبطَل القديمة وتُفعَّل الجديدة.
  pendingUntilConfirmed Boolean @default(false)

  @@index([userId])
}

// ==================== أجهزة موثوقة (لا تسألني على هذا الجهاز) ====================
//
// كتابةُ كودٍ عند كلّ دخولٍ من الحاسوب نفسه احتكاكٌ يوميّ يدفع الناس إلى
// **إطفاء التحقّق كلّه** - فالميزةُ التي تُتعِب تُلغى. تذكُّرُ الجهاز يبقي
// الحماية قائمةً حيث تنفع: أوّلُ دخولٍ من جهازٍ جديد يُسأل دائماً.
//
// 🔴 **والرمز مجزّأٌ لا نصّ:** من يقرأ الجدول لا يستطيع تزوير كوكي جهازٍ
// موثوق - وإلّا صار تسريبُ قاعدة البيانات تخطّياً للتحقّق بخطوتين لكلّ
// المستخدمين دفعةً واحدة.
//
// وله أجلٌ ينتهي: الثقة لا تُمنَح إلى الأبد، والجهاز يُباع ويُسرَق.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  /// لعرضها للمستخدم كي يعرف أيَّ جهازٍ يُلغي - لا للتحقّق.
  label      String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ==================== Workspaces (الفايلات) ====================

model Workspace {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String // اسم مساحة العمل كما يكتبه المشترك
  /// مساحة عرض ببيانات ثابتة. **كل أثر خارجي محظور منها** عبر
  /// `assertNotDemo` - ضغطة هنا يجب أن تستحيل أن توقف إعلاناً حقيقياً.
  isDemo                  Boolean   @default(false)
  demoExpiresAt           DateTime?
  /// اللغة التي بُذرت بها بيانات العرض. أسماء الحملات والمنتجات نصوص
  /// مخزَّنة لا مفاتيح، فلا تتبدّل بتبديل لغة الواجهة - ومن بذر ديموه
  /// بالعربية كان يرى أسماء عربية داخل واجهة إنجليزية كاملة إلى الأبد.
  /// اختلافها عن اللغة المطلوبة يُعيد بذر المساحة كاملةً (بياناتها أمثلة
  /// يجوز التخلّص منها، بخلاف أيّ مساحة حقيقية).
  demoLocale              String?
  /// إصدار البذرة التي أُنشئت بها هذه المساحة.
  ///
  /// **لماذا رقم إلى جانب اللغة:** تصحيحُ أرقام البذرة (كمعايرة الربحية)
  /// لا يغيّر اللغة، فلا يُعيد فحصُ اللغة بذرَ من عنده مساحةٌ قديمة - يبقى
  /// يرى الأرقام الخاطئة إلى الأبد بينما الملفّ مصحَّح. اختلاف الرقم عن
  /// `DEMO_SEED_VERSION` يُعيد البذر كما يفعل اختلاف اللغة تماماً.
  demoSeedVersion         Int?
  /// العملة التي بُذرت بها أرقام العرض. اختلافها عن `currency` يُعيد البذر
  /// بالعملة الجديدة - وهو الفرق بين **تحويل** المال و**إعادة تسميته**:
  /// أرقام العرض من صنعنا فتُولَّد بأيّ عملة، بخلاف الحساب الحقيقيّ.
  demoCurrency            String?
  /// عملة العرض في هذه المساحة.
  ///
  /// في المساحة الحقيقية **تساوي `dataCurrency` دائماً** ولا تُحرَّر يدوياً:
  /// راجع الحقل أدناه.
  currency                String    @default("SAR")
  /// العملة التي وصلت بها الأرقام فعلاً من الحساب الإعلانيّ.
  ///
  /// **ليست تفضيلاً بل خاصّية في البيانات.** جوجل وميتا تُثبتان عملة الحساب
  /// عند إنشائه ولا تسمحان بتغييرها، وكلّ رقمٍ نسحبه يأتي بها. وقائمة
  /// اختيار حرّة فوق ذلك لم تكن تحوّل شيئاً - كانت تُلصق لافتةً أخرى على
  /// المال نفسه، وهو تضليل لا خيار.
  ///
  /// `null` تعني: لا حساب إعلانيّ مربوط بعد، فلا شيء يناقض ما يختاره
  /// المستخدم. أوّل مزامنة تملؤها وتُثبّت `currency` عليها.
  dataCurrency            String?
  // هامش الربح - الأساس الحقيقي لحساب "نقطة تعادل ROAS" (= 1 ÷ الهامش)
  // بدل رقم ثابت عشوائي زي "3x للكل". مصادر متعددة متفقة: رقم ROAS
  // ثابت من غير معرفة الهامش قرار أعمى - هامش 25% معناه لازم 4x عشان
  // تتعادل، هامش 50% معناه 2x كفاية. اختياري - لو مش متحدد، القرار
  // بيرجع لمقارنة نسبية بمتوسط الحساب (أقل دقة لكن أفضل من لا شيء)
  profitMarginPct         Float?
  targetLocation          String? // السوق المستهدف "SA" | "EG" | "AE" ... - سياق مش قيد تقني
  // معرف صفحة فيسبوك (Page ID) - مطلوب لربط ويب هوك ماسنجر بمساحة العمل
  // الصحيحة (ميتا بتبعت page id بس، مش workspace id طبعاً)
  facebookPageId          String?   @unique
  /// معرّف رقم واتساب الأعمال (`phone_number_id` من Meta) - هو الهويّة
  /// الوحيدة التي يرسلها ويب هوك واتساب، فهو مفتاح ربط الرسالة الواردة
  /// بمساحة عملها. كان المتتبّع يعتمد خريطة عملاء مكتوبة في الكود
  /// بأسماء عملاء بعينهم، فكان يستحيل أن يستخدمه أيّ مشترك آخر.
  whatsappPhoneNumberId   String?   @unique
  /// رقم واتساب المعروض للزوّار (بالصيغة الدولية بلا +) - إليه يُحوَّل
  /// الزائر بعد النقر على الإعلان. منفصل عن المعرّف أعلاه: ذاك داخليّ
  /// من Meta، وهذا رقم يقرؤه البشر.
  whatsappBusinessPhone   String?
  /// معرّف حساب Google Ads الذي تُرفع إليه التحويلات غير المتّصلة.
  /// كان مقروءاً من متغيّر بيئة باسم العميل، فيحتاج نشراً جديداً لكلّ
  /// مشترك. يُملأ تلقائياً عند أوّل مزامنة، ويظلّ قابلاً للتعديل.
  googleAdsCustomerId     String?
  // آخر مرة المستخدم راجع صفحة مصطلحات البحث المهدرة - يغذّي تذكير
  // "معملتش مراجعة من فترة" في المهام اليومية (كان TODO قبل كده)
  lastSearchTermsReviewAt DateTime?
  // هدف الميزانية الشهري (اختياري) - من غيره، فحص "وتيرة الصرف" مينفعش
  // يحكم على أي حاجة، لأنه معندوش رقم مرجعي يقارن بيه
  // ==== تفضيلات التنبيهات - أنهي قناة توصل بيها التنبيهات العاجلة ====
  // داخل النظام دايماً موجود بغض النظر عن الإعدادات دي (Action Feed نفسه)
  // - دول بس بيتحكموا في هل يوصل كمان إيميل، ومتى
  notifyUrgentByEmail     Boolean   @default(true)
  notifyHighByEmail       Boolean   @default(false)
  notificationEmail       String? // لو فاضي، بيستخدم إيميل الحساب الأساسي
  // قواعد منفصلة تماماً عن الإيميل - المستخدم طلب صراحة قواعد مختلفة
  // لكل قناة، مش نفس التوجّل بيتحكم في القنوات كلها مع بعض
  notifyUrgentByPush      Boolean   @default(true)
  notifyHighByPush        Boolean   @default(true)
  // سقف أقصى لمجموع نسب تغيير المزايدة/الميزانية المُنفَّذة فعلياً في
  // نفس الشهر لكل إعلان/مجموعة - حاجز أمان يمنع تراكم تغييرات آلية
  // كتير فوق بعض في وقت قصير. افتراضي 50% (معقول ومحافظ، قابل للتعديل)
  monthlyChangeCeilingPct Float     @default(50)

  // ==== إعادة رفع التحويلات للمنصات (Server-Side Conversion Sync) ====
  // الحلقة المغلقة: نحن نعرف من العميل الدافع فعلاً، والمنصة لا تعرف.
  // رفع الحدث المتحقّق منه إليها يحسّن استهدافها لأنها تتعلّم على عملاء
  // حقيقيين لا على نقرات. كل توكن مشفّر بنفس آلية توكنات OAuth.
  conversionSyncEnabled      Boolean @default(false)
  // ترفع الأحداث المتحقّق منها فقط. إطفاؤه يرفع كل حدث (بما فيه غير
  // المتحقّق) - أكثر بيانات وأقل نقاءً، والقرار للمستخدم لا لنا.
  conversionSyncVerifiedOnly Boolean @default(true)

  metaPixelId              String?
  metaCapiToken            String? @db.Text // مشفّر
  // معرّف إجراء التحويل في جوجل (ConversionAction) - من دونه لا يعرف
  // جوجل أي تحويل نرفعه، فيُرفض الطلب كاملاً
  googleConversionActionId String?
  tiktokPixelCode          String?
  tiktokCapiToken          String? @db.Text // مشفّر

  monthlyBudgetTarget Float?
  createdAt           DateTime @default(now())

  // ON: الـ CPL/ROAS بتحسب Verified + Modeled مع بعض (بفصل واضح في العرض)
  // OFF: الحسابات بتشتغل على Verified بس، والمجهول بيفضل رقم توعوي بره الحسابات
  useModeledAttribution Boolean @default(false)

  // حد أقصى (بالدقايق) لاعتبار الرد "سريع" - قابل للتعديل لكل Workspace
  responseTimeThresholdMinutes Int @default(15)

  // حد التوقف (بالدقايق) لاعتبار محادثة ماسنجر "ضغطة بالخطأ" - قابل
  // للتعديل، بدل ما يكون رقم ثابت (120 دقيقة) مقفول جوه الكود
  messengerInactivityThresholdMinutes Int @default(120)

  // "المصدر الأساسي" للتحويل لكل Workspace - بيتحكم في أنهي قناة نعتبرها
  // مرجع أساسي وقت المقارنة بين ماسنجر/واتساب/فورم على نفس الحملة
  primaryConversionSource String @default("WHATSAPP") // WHATSAPP | MESSENGER | LEAD_FORM

  // نص الرد التلقائي/رسالة الترحيب المستخدمة في واتساب بيزنس بتاع العميل
  // بيُستخدم لاستبعاد الردود الأوتوماتيك من حساب سرعة رد فريق المبيعات الحقيقي
  autoReplyText String? @db.Text

  // ==== مفاتيح تشغيل/إيقاف رئيسية لكل نظام - تحكم كامل زي ما طلب المستخدم ====
  // كل نظام فرعي له مفتاح مستقل، عشان أي حد يقدر يوقف جزء معين مؤقتاً
  // من غير ما يأثر على الباقي (مثال: يوقف الأتمتة بس، ويسيب التشخيص شغال)
  enableAIInsights          Boolean @default(true)
  // إيقاف الحملات تلقائياً عند نفاد مخزون المنتج المرتبط بها
  pauseAdsOnOutOfStock      Boolean @default(false)
  enableAutomationRules     Boolean @default(true)
  enableDailyDiagnostics    Boolean @default(true)
  enablePricingHealthChecks Boolean @default(true)

  // ==== عتبات قابلة للتعديل - كانت أرقام ثابتة جوه الكود، بقت إعدادات ====
  adFatigueFrequencyThreshold Float @default(3.5) // فوقه = "الإعلان تعبان"
  ctrDropThresholdPct         Int   @default(30) // % الانخفاض اللي يستاهل تنبيه
  pricingWarningThresholdPct  Int   @default(5) // % الفرق عن السعر المطلوب - منطقة تحذير مبكر
  pricingCriticalThresholdPct Int   @default(15) // % الفرق - خطر عاجل
  rtoAnomalyMultiplier        Float @default(2.0) // نسبة المرتجعات مقارنة بالمتوسط قبل ما تعتبر "غير طبيعية"

  // ==== نتيجة الـ Onboarding - بيحدد الـ Default الذكي للداشبورد ====
  // إجابات المستخدم وقت إنشاء الـ Workspace: مين المنصات المستخدمة، ونوع المجال
  industryVertical String? // "ecommerce" | "recruitment" | "clinic" | "real_estate" | "b2b" | ...
  activePlatforms  Platform[] // المنصات اللي هيربطها فعلاً (بيحدد شكل الداشبورد الافتراضي)

  // قائمة بمفاتيح المقاييس اللي المستخدم عايز يشوفها - قابلة للتعديل في أي وقت
  // مثال: ["cpl_verified", "roas", "ctr", "video_hook_rate"]
  // لو null، بيتحسب default ذكي بناءً على industryVertical + activePlatforms
  visibleMetrics Json?
  onboarded      Boolean @default(false)

  campaignLinks              CampaignLink[]
  uploadedSheets             UploadedSheet[]
  savedReportViews           SavedReportView[]
  competitors                Competitor[]
  metricSnapshots            MetricSnapshot[]
  conversionVerifications    ConversionVerification[]
  conversionValueConfig      ConversionValueConfig?
  automationRules            AutomationRule[]
  landingPageAudits          LandingPageAudit[]
  dailyTasks                 DailyTask[]
  actionFeedItems            ActionFeedItem[]
  experimentLogs             ExperimentLog[]
  ctaClickEvents             CtaClickEvent[]
  touchpoints                Touchpoint[]
  conversionEvents           ConversionEvent[]
  adDecisionRecords          AdDecisionRecord[]
  syncRuns                   SyncRun[]
  customers                  Customer[]
  orders                     Order[]
  products                   Product[]
  ecommerceConnections       EcommerceConnection[]
  creativeSnapshots          CreativeSnapshot[]
  monitoredPages             MonitoredPage[]
  searchTermSnapshots        SearchTermSnapshot[]
  sharedReportLinks          SharedReportLink[]
  messengerConversations     MessengerConversation[]
  audienceSegmentSnapshots   AudienceSegmentSnapshot[]
  siteScanResults            SiteScanResult[]
  metaAdSetSnapshots         MetaAdSetSnapshot[]
  qualityScoreSnapshots      QualityScoreSnapshot[]
  shoppingProductSnapshots   ShoppingProductSnapshot[]
  pmaxChannelSnapshots       PmaxChannelSnapshot[]
  youtubeMetricSnapshots     YoutubeMetricSnapshot[]
  devicePerformanceSnapshots DevicePerformanceSnapshot[]
  geoPerformanceSnapshots    GeoPerformanceSnapshot[]
  matchTypeSnapshots         MatchTypeSnapshot[]
  displayPlacementSnapshots  DisplayPlacementSnapshot[]
  leadFormSubmissions        LeadFormSubmission[]
  adSetDailyConversions      AdSetDailyConversions[]
  catalogCampaignSnapshots   CatalogCampaignSnapshot[]
  tikTokVideoMetricSnapshots TikTokVideoMetricSnapshot[]
  tikTokWeeklyEngagements    TikTokWeeklyEngagement[]

  // سقف إجمالي شهري لأي تغييرات ميزانية عن طريق الأتمتة (زيادة أو تقليل)،
  // بغض النظر عن عدد القواعد أو القرارات المعتمدة - حماية أخيرة من انجراف
  // الميزانية بمرور الوقت حتى لو كل قرار فردي كان معقولاً وقت اتخاذه
  automationMonthlyBudgetChangeCeilingPct Int?            @default(50)
  agentChats                              AgentChat[]
  mcpTokens                               McpToken[]
  platformUsage                           PlatformUsage[]
  mcpAuthCodes                            McpAuthCode[]
}

// أي كامبين (من جوجل أو ميتا) تم اختياره ليتبع لـ Workspace معين
model CampaignLink {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform           Platform
  externalAccountId  String // Google Ads customer id / Meta ad account id
  externalCampaignId String // campaign id في المنصة نفسها
  campaignName       String
  addedAt            DateTime  @default(now())

  /// 🔴 **المتجر الذي تبيع له هذه الحملة - وبدونه لا وجود لـROAS لكلّ متجر.**
  ///
  /// الإيراد منسوبٌ إلى متجره (`Order.connectionId`)، أمّا الإنفاق فلا:
  /// الحملة تُشترى للمساحة، ولا تحمل المنصّاتُ الإعلانية أيّ إشارةٍ إلى
  /// أيّ متجرٍ أرسلت إليه الزائر. فقسمة الإنفاق على المتاجر بالتساوي أو
  /// بنسبة الإيراد تُنتج ROAS **يبدو دقيقاً وهو مخترع**.
  ///
  /// والنسبة على **الحملة** لا على الحساب الإعلانيّ: الحساب الواحد يخدم
  /// المتجرين روتينياً (حملةٌ لكلّ متجر بصفحة هبوطٍ مختلفة)، فربطُ الحساب
  /// بمتجر يخطئ في الحالة الشائعة لا النادرة.
  ///
  /// اختياريّ: ما لم يُنسَب يُعرض إنفاقاً غير منسوب، ولا يُقسَّم.
  connectionId String?
  connection   EcommerceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // آخر بيانات استراتيجية مزايدة معروفة - بتتحدث يومياً عن طريق الـ cron،
  // مش بتُستدعى حية وقت فتح صفحة التشخيص (تجنباً لبطء وحصة API استهلاك زيادة)
  biddingStrategyType  String?
  targetCpa            Float?
  targetRoas           Float?
  biddingDataUpdatedAt DateTime?

  @@unique([workspaceId, platform, externalCampaignId])
  // بيخدم نمط بحث الـ webhooks (سلة/شوبيفاي): "لاقي الـ Workspace بتاع
  // المتجر ده" - من غير الـ index ده، كل webhook هيعمل فحص كامل للجدول
  @@index([platform, externalAccountId])
}

// ==================== البيانات المسحوبة يومياً ====================

// جدول التحقّق المستقلّ (C-1/D-1): الزيادة الحقيقية للتحويلات المتحقَّقة
// تُكتب هنا لا على MetricSnapshot. السبب: صفّ MetricSnapshot المجمَّع
// (`ALL/ALL`) قد لا يوجد إطلاقاً (ميتا تكتب صفوفاً مقسَّمة على مكان الظهور)
// أو لا يكون وُجد بعد (جوجل - تحقّقُ نفس-اليوم قبل مزامنته)، فكان `updateMany`
// عليه يصيب صفر صفوف ويضيع التحقّق بالصمت - وهو جوهر وعد المنتج. جدولٌ
// مستقلٌّ يُكتب بـ`upsert` فلا يضيع أبداً، ويُطبَّق فوق أرقام المنصّة عند
// القراءة في `lib/metricRollup.ts` (مجموعٌ لا استبدال، فأرقام العرض تبقى).
model ConversionVerification {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform      Platform
  campaignId    String // externalCampaignId
  date          DateTime  @db.Date
  verifiedCount Int       @default(0)
  updatedAt     DateTime  @updatedAt

  /// الإعلان الفرديّ حين يُعرَف - وهو ما يجعل التحقّق يصل إلى مستوى
  /// الإبداع لا الحملة وحدها (GAP-1). ويب هوك ماسنجر وحده يحمله اليوم
  /// (`referral.ad_id`)؛ ونقرة واتساب لا تحمل معرّف إعلان فتبقى `"ALL"`،
  /// ويُحسَب تحقّقُها على الحملة وحدها. **لا يُوزَّع تحقّقُ حملةٍ على
  /// إعلاناتها تخميناً** - رقمٌ مخترَعٌ على مستوى الإعلان يقود قرار
  /// إيقاف/توسيع خاطئاً، وغيابُه أصدق منه.
  ///
  /// **`"ALL"` لا `null` عمداً:** بوستجرس يعدّ القيم الغائبة **متمايزة**
  /// في القيد الفريد، فصفٌّ بـ`null` لا يطابق نفسه أبداً - فيُنشئ `upsert`
  /// صفّاً جديداً مع كلّ رسالة بدل أن يزيد القائم، **فيتضاعف العدّ**.
  /// والقيمة الصريحة تجعل المفتاح يطابق. وهي نفس عادة `placementBreakdown`
  /// في `MetricSnapshot`.
  adId String @default("ALL")

  @@unique([workspaceId, platform, campaignId, date, adId])
  @@index([workspaceId, date])
  @@index([workspaceId, adId, date])
}

model MetricSnapshot {
  id                 String    @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform           Platform
  campaignId         String // externalCampaignId
  date               DateTime  @db.Date
  // "ALL" = مجمّع، القيم التانية (facebook/instagram/audience_network/messenger)
  // من publisher_platform breakdown
  placementBreakdown String    @default("ALL")
  // مكان الظهور التفصيلي (Feed/Stories/Reels/Search) - بُعد منفصل عن
  // المنصة نفسها، من breakdowns=placement بارامتر مختلف تماماً
  placementDetail    String    @default("ALL")

  impressions         Int   @default(0)
  clicks              Int   @default(0)
  cost                Float @default(0) // بعملة الحساب الأصلية
  // conversions "الخام" زي ما المنصة بتحسبها (dashboard conversions)
  rawConversions      Float @default(0)
  // conversions "الحقيقية" بعد ما اترجعت من نظام تتبع الواتساب المُتحقق منه
  verifiedConversions Int   @default(0)

  // ==== مقاييس الفيديو (اختيارية - بتتملى بس لو الكامبين نوعه فيديو) ====
  videoViews           Int? // عدد المشاهدات
  videoViewRate        Float? // نسبة المشاهدة % (views / impressions)
  videoThruPlays       Int? // مشاهدات كاملة (ميتا/TikTok/Snapchat)
  videoAvgWatchTimeSec Float? // متوسط وقت المشاهدة بالثانية
  videoCpv             Float? // Cost Per View

  // ==== مقاييس الإيكومرس (اختيارية - بتتملى من Salla/Shopify/Easy Orders) ====
  ordersCount         Int? // عدد الطلبات
  // 🔴 **إيرادان مختلفان، ولا يجوز جمعهما في حقلٍ واحد.**
  //
  // `revenue` هنا = ما **تنسبه المنصّة الإعلانية لإعلانها** (جوجل
  // `conversions_value`، ميتا `action_values`، تيك توك
  // `total_purchase_value`) - وهو البسط الصحيح لـROAS.
  //
  // أمّا مبيعات المتجر كلّها (من ويب هوك سلة/شوبيفاي) فتشمل العضويّ
  // والمباشر والعملاء المتكرّرين، وقسمتُها على الصرف الإعلانيّ لا تعطي
  // عائداً على الإعلان بل رقماً منفوخاً يتحسّن حين يزيد بيعُك بلا إعلان.
  // فلها حقلها المستقلّ، وتُعرَض باسمها الصريح.
  revenue             Float? // إيراد منسوب للإعلان - من المنصّة نفسها
  storeRevenue        Float? // مبيعات المتجر كلّها في اليوم - من ويب هوك المتجر
  cogs                Float? // Cost of Goods Sold - تكلفة المنتج نفسه
  shippingCost        Float? // تكلفة الشحن الفعلية
  returnedOrdersCount Int? // عدد الطلبات المرتجعة (RTO - خاص بالدفع عند الاستلام)

  // ==== مراحل السلّة والدفع - من **المنصّة الإعلانية** لا من ويب هوك المتجر ====
  //
  // 🔴 كان مكتوباً في هذا المشروع أنّ هاتين المرحلتين غير متاحتين لأنّ ويب
  // هوك الطلب لا يرسلهما. وهذا صحيحٌ وغيرُ ذي صلة: المنصّات نفسها تبلّغ
  // عنهما كأحداث تحويلٍ لها تكلفتها المستقلّة.
  //   • جوجل: `ADD_TO_CART` و`BEGIN_CHECKOUT` فئتا تحويلٍ رسميّتان،
  //     تُقرآن بتقسيم `metrics.conversions` على `segments.conversion_action`.
  //   • ميتا: `add_to_cart` و`initiate_checkout` داخل مصفوفة `actions`
  //     التي نقرأها **بالفعل** لاستخراج الليدز - سطرٌ واحد كان يفصلنا عنهما.
  addToCart        Int? // أضاف للسلّة
  checkoutsStarted Int? // بدأ الدفع

  @@unique([workspaceId, platform, campaignId, date, placementBreakdown, placementDetail])
  @@index([workspaceId, date])
}

/// عرض تقرير محفوظ - يحفظ *إعدادات* التقرير لا نتيجته.
/// النتيجة تُحسب عند كل فتح من بيانات اليوم، وإلا صار التقرير صورة قديمة
/// تُتّخذ عليها قرارات جديدة. هذا هو الفرق بين تقرير حيّ وتقرير ميّت.
model SavedReportView {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  /// إعدادات كاملة: المصدر، الفترة، المؤشّرات، الأبعاد، المرشّحات، نوع المقارنة
  config       Json
  isFavorite   Boolean   @default(false)
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, userId])
}

/// منافس تتابعه. الـAPI الرسمي لمكتبة إعلانات ميتا يُرجع الإعلانات
/// التجارية لدول الاتحاد الأوروبي وبريطانيا فقط (قيد الـDSA) - مصر
/// والخليج خارج التغطية، فلا سبيل آلياً. البديل هنا ليس تخزيناً فحسب:
/// نشتقّ ما لا تعرضه المكتبة نفسها - مدّة بقاء كل إعلان.
model Competitor {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  /// رابط صفحتهم أو مكتبة إعلاناتهم - للفتح السريع عند البحث عن جديد
  pageUrl String?
  country String  @default("EG")
  notes   String? @db.Text

  ads       CompetitorAd[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([workspaceId])
}

/// إعلان رصدته لمنافس. `firstSeenAt`/`lastSeenAt` هما جوهر القيمة:
/// الإعلان الذي يُبقيه المنافس شهوراً هو إعلانه الرابح - وهذه إشارة لا
/// تعرضها مكتبة الإعلانات لأنها لا تحتفظ بتاريخ رصدك أنت.
model CompetitorAd {
  id           String     @id @default(cuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  workspaceId  String

  platform   String  @default("META_ADS")
  format     String  @default("IMAGE") // IMAGE | VIDEO | CAROUSEL | TEXT
  headline   String?
  body       String? @db.Text
  ctaLabel   String?
  landingUrl String?
  /// صورة الإعلان كـdata URI أو رابط - نفس نهج الصورة الشخصية
  imageUrl   String? @db.Text
  sourceUrl  String? @db.Text

  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  /// يُطفأ يدوياً عند ملاحظة توقّفه - عندها تتجمّد مدّة البقاء
  stillRunning Boolean  @default(true)

  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, competitorId])
}

enum PaymentIntentKind {
  SUBSCRIPTION
  CREDITS
}

enum PaymentIntentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// نية دفع. **هذا الجدول هو الحماية من الشحن المزدوج.**
///
/// بدونه كانت كل ضغطة على "اشترك" تُنشئ نية جديدة عند Paymob - فمن يضغط
/// مرّتين، أو يعود بزرّ المتصفّح، يحصل على رابطَي دفع صالحين معاً.
///
/// الآن: نيّة معلّقة حديثة لنفس المستخدم ونفس الطلب تُعاد كما هي بدل
/// إنشاء غيرها. والتفعيل يبقى من الويب هوك وحده - صفحة النجاح تُفتح
/// بلا دفع، فبناء الاشتراك عليها ثغرة لا اختصار.
model PaymentIntent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind    PaymentIntentKind
  /// للاشتراك: مفتاح الباقة. للكريدت: null
  planKey String?
  cycle   String? // monthly | yearly
  /// للكريدت: العدد المشترى. للاشتراك: null
  credits Int?

  /// **المبلغ والعملة المُحصَّلان فعلاً** - أي ما تراه Paymob وما يقارنه
  /// الويب هوك. والتحصيل بالجنيه دائماً لأنّ تكامل MIGS لا يقبل غيره.
  amountCents Int
  currency    String

  /// **والسعر كما رآه العميل** - قد يكون بالدولار أو بالريال. يُحفَظ
  /// ليُفسَّر الإيصال لاحقاً: من رأى ١٤٩ دولاراً ووجد خصماً بالجنيه يحتاج
  /// أن يعرف بأيّ سعر صرفٍ حُسب، وإلّا بدا الرقم مخترَعاً.
  listAmountCents   Int?
  listCurrency      String?
  fxRateUsed        Float?
  /// معرّف النيّة لدى Paymob - للمطابقة عند وصول الويب هوك
  paymobIntentionId String?
  /// 🔴 **الرابط الوحيد المضمون بين العملية ونيّتها.**
  ///
  /// كان `intention_order_id` يعود من Paymob **ولا يُخزَّن**، فيبقى مطابقةُ
  /// الويب هوك معتمدةً على `extras` وحدها - وهي حقلٌ يضعه Paymob حيث يشاء
  /// من الحمولة، فإن لم يكن حيث نبحث سقط الإتمام صامتاً بردّ `200`.
  /// و`obj.order.id` في الويب هوك هو هذا الرقم نفسه.
  paymobOrderId     String?
  checkoutUrl       String? @db.Text

  status        PaymentIntentStatus @default(PENDING)
  /// معرّف المعاملة عند Paymob بعد الدفع - دليل السداد لا تخميننا
  transactionId String?
  failureReason String?
  paidAt        DateTime?

  /// مفتاح تفرّدٍ للنيّة المعلّقة الواحدة - يُفرَغ فور خروجها من التعليق.
  ///
  /// 🔴 **قيدٌ من قاعدة البيانات لا ترتيبٌ في الكود.** كان الإنشاء يبحث عن
  /// نيّةٍ معلّقةٍ مطابقة ثمّ يُنشئ - وبين البحث والإنشاء نافذةٌ يمرّ منها
  /// طلبٌ ثانٍ: نقرةٌ مزدوجة أو إعادة محاولةٍ من المتصفّح تنتجان رابطَي
  /// دفعٍ صالحين لنفس الشيء، فيُخصَم من العميل مرّتين. ولا يُغلق ذلك
  /// بترتيبٍ أدقّ في الكود، لأنّ الطلبين في عمليتين متوازيتين.
  ///
  /// ويُفرَغ عند الدفع أو الفشل: القيد يمنع نيّتين معلّقتين لنفس الشراء،
  /// لا أن يشتري العميل الشيءَ نفسَه مرّتين في حياته.
  /// 🔴 **بلا `@unique` عمداً.** إضافة قيد تفرّدٍ تجعل `prisma db push`
  /// يطلب `--accept-data-loss`، والبناء يرفضها بحقّ - فتلك الراية تُسقط
  /// أعمدةً وجداول. فالتسلسل يأتي من قفل معاملةٍ في `lib/billing.ts` لا
  /// من قيدٍ يمنع النشر.
  dedupeKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([paymobIntentionId])
  @@index([paymobOrderId])
}

// بيانات مرفوعة يدوي (Excel) - بتتخزن بنفس شكل MetricSnapshot تقريباً
// عشان تدخل في نفس المقارنات والحسابات
model UploadedSheet {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName    String
  sourceLabel String // اسم يديه المستخدم للمصدر ده، مثلاً "TikTok Ads" أو "Snapchat"
  uploadedAt  DateTime           @default(now())
  rowsCount   Int
  rows        UploadedSheetRow[]
}

model UploadedSheetRow {
  id              String        @id @default(cuid())
  uploadedSheetId String
  uploadedSheet   UploadedSheet @relation(fields: [uploadedSheetId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  campaignName    String
  impressions     Int           @default(0)
  clicks          Int           @default(0)
  cost            Float         @default(0)
  conversions     Float         @default(0)

  @@index([uploadedSheetId])
}

// عشان نحسب ROAS/ROI حقيقي، محتاجين "قيمة" لكل conversion محددة يدوي لكل Workspace
model ConversionValueConfig {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  avgLeadToClientRate Float // نسبة تحويل الليد لعميل فعلي (مثلاً 0.15 = 15%)
  avgClientValue      Float // متوسط قيمة العميل الواحد بالعملة المحلية
  updatedAt           DateTime  @updatedAt
}

enum SubscriptionStatus {
  NONE // لسه معملش اشتراك خالص
  TRIALING // في فترة تجربة (لو فعّلناها لاحقاً)
  ACTIVE // مدفوع وشغال
  PAST_DUE // فشل تحصيل التجديد بالتوكن المحفوظ - محتاج إعادة محاولة أو تحديث بيانات دفع
  CANCELED // اتلغى فعلياً (بعد ما تخلص الفترة المدفوعة لو cancelAtPeriodEnd كان true)
}

enum Platform {
  GOOGLE_ADS
  META_ADS
  TIKTOK_ADS
  SNAPCHAT_ADS
  SALLA
  SHOPIFY
  EASY_ORDERS
  ZID
  WOOCOMMERCE
  MANUAL_UPLOAD
}

// ==================== Attribution Engine (خدمة مستقلة) ====================
// الجداول دي مصممة تشتغل لوحدها كخدمة منفصلة، وكمان تتستخدم جوه Workspace
// عادي لو الـ toggle شغال. مفيش أي ربط إجباري بينها وبين باقي جداول AdLoop.

// كل كليك (حتى لو لسه معندوش رسالة مطابقة) - ده "المرشحين" للتوزيع الاحتمالي
model UnmatchedClick {
  id          String   @id @default(cuid())
  workspaceId String // ممكن يكون Workspace في AdLoop، أو "attribution-only" project id
  platform    Platform
  code        String // الكود اللي اتولد وقت الكليك
  gclid       String?
  phoneHint   String? // لو الصفحة سحبت رقم الهاتف قبل التحويل لواتساب
  ipAddress   String? // لكشف أنماط البوتات (كليكات متكررة من نفس الـ IP بمعدل غير طبيعي)
  userAgent   String?  @db.Text // طبقة كشف تانية - نفس مبدأ CtaClickEvent، إشارة مجانية من المتصفح تلقائياً
  clickedAt   DateTime
  matched     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([workspaceId, matched, clickedAt])
}

// نتيجة التوزيع الاحتمالي لكل محادثة "مجهولة المصدر"
model AttributionResult {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String   @unique // معرف الرسالة الواردة من webhook واتساب
  receivedAt     DateTime

  // هل اترجعت لكود معروف مباشرة (Verified) ولا احتاجت توزيع احتمالي (Modeled)
  attributionType AttributionType

  // لو Verified: منصة واحدة بثقة 100%. لو Modeled: JSON فيه توزيع الاحتمالات
  // مثال: {"GOOGLE_ADS": 0.82, "META_ADS": 0.18}
  probabilityDistribution Json

  // أهم إشارة استُخدمت في القرار (للشفافية والتدقيق لاحقاً)
  primarySignal String? // "time_proximity" | "phone_match" | "hourly_pattern" | "baseline_ratio"

  createdAt DateTime @default(now())
}

enum AttributionType {
  VERIFIED // كود مطابق مباشر
  MODELED // توزيع احتمالي
}

// ==================== قائمة يومية ذكية (Smart Daily Checklist) ====================

model DailyTask {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date // اليوم اللي اترشحت فيه المهمة دي

  /// النصّ المعروض وقت التوليد - يبقى كاحتياطي للصفوف القديمة وللمهام
  /// المولّدة بالذكاء الاصطناعي (نصّها حرّ لا مفتاح له).
  title             String // "راجع Search Terms Report - آخر مراجعة من 8 أيام"
  /// مفتاح القاموس ومتغيّراته بدل النصّ الجاهز: المهمة تُولَّد مرّة واحدة
  /// يومياً وتُقرأ مراراً، فتخزين النصّ المترجَم يثبّت لغة لحظة التوليد
  /// على القارئ مهما غيّر لغته. المفتاح يُترجَم وقت العرض بلغة القارئ.
  titleKey          String?
  titleVars         Json?
  category          TaskCategory
  priority          TaskPriority @default(MEDIUM)
  source            TaskSource // rule-based ولا AI-generated
  relatedCampaignId String? // لو مرتبطة بكامبين معين

  completed    Boolean   @default(false)
  completedAt  DateTime?
  snoozedUntil DateTime? // لو المستخدم أجّلها

  createdAt DateTime @default(now())

  @@index([workspaceId, date, completed])
}

enum TaskCategory {
  PRICING_RISK // فحص أساسي يومي - أعلى أولوية دائماً (وليس اختيارياً)
  SEARCH_TERMS // مراجعة الكلمات المفتاحية الفعلية اللي جابت كليكات
  NEGATIVE_KEYWORDS
  TRACKING_HEALTH // فحص إن الـ conversion tracking لسه شغال (مش واقف بصمت)
  TAG_HEALTH // وسم تتبع بايظ/معطل (مختلف عن TRACKING_HEALTH - ده خاص بالتنصيب التقني نفسه)
  CTR_DROP // انخفاض حاد في نسبة النقر مقارنة بالمعتاد
  PAGE_SPEED // بطء تحميل صفحة الهبوط بشكل يؤثر على التحويل
  BUDGET_PACING // هل الصرف على المسار الصحيح للوصول لميزانية الشهر
  AD_FATIGUE // تكرار الظهور (Frequency) عالي، وقت تغيير الكرياتيف
  QUALITY_SCORE
  DISAPPROVED_ADS
  COMPETITOR_ACTIVITY
  ANOMALY // اكتشاف تلقائي (AI) لحاجة غريبة في الأرقام
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  RULE_BASED // قاعدة ثابتة (كل 7 أيام مثلاً)
  AI_DETECTED // ناتج من تحليل AI للانحرافات في البيانات
}

// ==================== محرك الأتوميشن (Automation Rules) ====================
// مبدأ أساسي: القواعد هنا مبنية بس على بيانات "الحقيقة" (Verified/True)
// اللي المنصة نفسها معندهاش - مش تكرار لـ Google Ads Automated Rules أو
// Meta Ads Rules اللي أصلاً بتشتغل مجاناً على بيانات المنصة الخام.

model AutomationRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String // اسم يديه المستخدم للقاعدة، مثلاً "إيقاف عند تضخيم المنصة"

  // الشرط - مبني على مقاييس "الحقيقة" فقط (مش raw platform metrics)
  metric          RuleMetric
  operator        RuleOperator
  threshold       Float
  consecutiveDays Int          @default(1) // الشرط لازم يتحقق كام يوم متتالي قبل التنفيذ

  // هل الحساب يعتمد على المؤكد بس، ولا يشمل التوزيع الاحتمالي (Modeled)
  // كمان - كل قاعدة تختار مستوى ثقتها بشكل مستقل عن باقي القواعد
  attributionBasis RuleAttributionBasis @default(VERIFIED_ONLY)

  // الإجراء
  action      RuleAction
  actionValue Float? // مثلاً نسبة تقليل/زيادة الميزانية

  // ==== ضمانات الأمان المالي (بنفس فلسفة الـ Rate Limiting) ====
  maxSingleJumpPct Int?      @default(20) // أقصى نسبة تغيير ميزانية في الإجراء الواحد
  cooldownDays     Int       @default(3) // أقل مدة بين إجراءين على نفس الكامبين
  lastExecutedAt   DateTime? // آخر مرة اتنفذ فيها إجراء - لحساب الـ cooldown

  // نطاق التطبيق
  platform            Platform? // null = كل المنصات؛ أو منصة بعينها
  appliesTo           RuleScope @default(ALL_CAMPAIGNS)
  specificCampaignIds String[]  @default([])

  enabled         Boolean @default(true)
  requireApproval Boolean @default(true) // لو true، القاعدة تقترح بس ومتنفذش أوتوماتيك من غير موافقة

  createdAt  DateTime        @default(now())
  executions RuleExecution[]
}

enum RuleAttributionBasis {
  VERIFIED_ONLY // بس المحادثات المؤكدة 100%
  INCLUDE_MODELED // المؤكد + نصيب المنصة من التوزيع الاحتمالي (لو الـ Workspace مفعّل عنده)
}

model RuleExecution {
  id                   String          @id @default(cuid())
  ruleId               String
  rule                 AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  campaignId           String
  triggeredAt          DateTime        @default(now())
  metricValueAtTrigger Float
  actionTaken          String // وصف الإجراء اللي اتنفذ فعلياً
  status               ExecutionStatus @default(PENDING_APPROVAL)
  approvedAt           DateTime?
}

enum RuleMetric {
  // ==== طبقة الحقيقة (جوهر المنتج) ====
  CPL_VERIFIED // تكلفة العميل الحقيقي المتحقق منه
  CPL_REPORTED // تكلفة العميل كما تعلنها المنصة
  INFLATION_RATE // نسبة تضخيم المنصة مقارنة بالحقيقة
  VERIFICATION_RATE // نسبة التحويلات التي تم التحقق منها فعلاً
  UNATTRIBUTED_RATE // نسبة المحادثات المجهولة المصدر
  VERIFIED_CONVERSIONS // عدد التحويلات المحقّقة

  // ==== التكلفة والكفاءة ====
  SPEND // إجمالي الإنفاق
  CPC // تكلفة النقرة
  CPM // تكلفة الألف ظهور
  CTR // نسبة النقر
  CONVERSION_RATE // نسبة التحويل من النقرة

  // ==== الربحية ====
  TRUE_ROAS // العائد الحقيقي بعد كل التكاليف (إيكومرس)
  REPORTED_ROAS // العائد كما تعلنه المنصة
  PROFIT_MARGIN_PCT // هامش الربح الفعلي
  BREAK_EVEN_DISTANCE // بُعد العائد عن نقطة التعادل

  // ==== الإبداع والتعب ====
  FREQUENCY // متوسط تكرار ظهور الإعلان للشخص
  CTR_DECLINE_PCT // نسبة انحدار CTR مقارنة ببدايته
  CREATIVE_AGE_DAYS // عمر الإعلان بالأيام

  // ==== الجودة والترافيك ====
  BOUNCE_SIGNAL_PCT // نسبة النقرات بلا أي تفاعل لاحق
  SUSPICIOUS_TRAFFIC_PCT // نسبة الترافيك المشبوه المكتشف
  QUALITY_SCORE // درجة الجودة (جوجل)
  DISAPPROVED_ADS_COUNT // عدد الإعلانات المرفوضة

  // ==== الميزانية والوتيرة ====
  BUDGET_UTILIZATION_PCT // نسبة استهلاك الميزانية اليومية
  IMPRESSION_SHARE_LOST_BUDGET // حصة الظهور المفقودة بسبب الميزانية

  // ==== التشغيل ====
  RESPONSE_TIME_MINUTES // سرعة رد الفريق الحقيقية
  LEARNING_PHASE_DAYS // عدد أيام بقاء الحملة في فترة التعلّم

  // ==== الإيكومرس ====
  RTO_RATE // نسبة المرتجعات
  AOV // متوسط قيمة الطلب
  CATALOG_SPEND_NO_SALES // إنفاق على كتالوج بلا مبيعات
  STOCK_REMAINING // الكمية المتبقية من المنتج
  STOCK_DAYS_LEFT // الأيام المتبقية قبل النفاد بمعدل البيع الحالي
  OUT_OF_STOCK_COUNT // عدد المنتجات المنتهية في مساحة العمل
  STOCK_COVER_RATIO // نسبة تغطية المخزون مقابل وتيرة الإعلان
}

enum RuleOperator {
  GREATER_THAN
  LESS_THAN
}

enum RuleAction {
  PAUSE_CAMPAIGN
  PAUSE_AD // إيقاف الإعلان الفردي دون الحملة كلها
  REDUCE_BUDGET_PCT
  INCREASE_BUDGET_PCT
  ADJUST_BID_PCT // تعديل المزايدة بنسبة
  SEND_ALERT_ONLY // مجرد تنبيه، من غير أي تنفيذ فعلي
}

enum RuleScope {
  ALL_CAMPAIGNS
  SPECIFIC_CAMPAIGNS
}

enum ExecutionStatus {
  PENDING_APPROVAL // مستني موافقة المستخدم (requireApproval = true)
  EXECUTED
  REJECTED
}

// ==================== تدقيق صفحة الهبوط (Landing Page Audit) ====================
// تدقيق شامل حقيقي، مش قائمة سطحية - يجمع فحوصات تقنية قابلة للقياس
// (SEO، Schema، سرعة التحميل) مع تحليل عميق بالذكاء الاصطناعي (تصميم،
// نصوص الإقناع، وضوح أزرار الدعوة للفعل، جودة الصور، ثقة المستخدم).

model LandingPageAudit {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url         String
  auditedAt   DateTime  @default(now())

  overallScore Int // 0-100

  // نتيجة كل فئة على حدة + النتائج التفصيلية (JSON لأن كل فئة شكل نتائجها مختلف)
  designTrustScore    Int
  designTrustFindings Json

  copywritingScore    Int
  copywritingFindings Json

  ctaScore    Int
  ctaFindings Json

  layoutScore    Int
  layoutFindings Json

  // مقترح استقطاب أول عميل - نوعه بيتحدد حسب المجال (خصم، ضمان، استشارة
  // مجانية، دراسة حالة، إلخ)، مش دايماً "عرض" تقليدي
  acquisitionSuggestionType String // "discount" | "guarantee" | "free_consultation" | "case_study" | "trial" | "certification_display"
  acquisitionSuggestion     String? @db.Text

  domainTrustScore    Int
  domainTrustFindings Json

  seoScore    Int
  seoFindings Json

  imageQualityScore    Int
  imageQualityFindings Json

  mobileExperienceScore    Int
  mobileExperienceFindings Json

  trustSignalsScore    Int
  trustSignalsFindings Json

  valueClarityScore    Int // هل زائر الصفحة بيفهم "بيقدملك إيه بالظبط" خلال ثوان؟
  valueClarityFindings Json

  formFrictionScore    Int? // null لو مفيش فورم أصلاً في الصفحة
  formFrictionFindings Json?

  legalComplianceScore    Int // سياسة الخصوصية، الشروط، سياسة الإرجاع (مهم جداً لثقة الإيكومرس)
  legalComplianceFindings Json
}

// ==================== Action Feed (= AI Command Center + Alerts، مدموجين) ====================
// نفس الـ engine لبندين كانوا مقترحين منفصلين - أي بند سواء كان "اقتراح
// تنفيذي" (وفّر فلوس، زوّد ميزانية) أو "تنبيه" (تراكينج واقف، ميزانية
// هتخلص) بيظهر في نفس القائمة الموحّدة، بفرق بس في `type` و`severity`.

model ActionFeedItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type        ActionFeedType
  severity    TaskPriority // نفس enum الأولوية المستخدم في DailyTask - توحيد بدل تكرار
  /// النصّ المعروض وقت التوليد - احتياطي للصفوف القديمة وللنصوص الحرّة
  /// (المولّدة بالذكاء الاصطناعي مثلاً) التي لا مفتاح قاموس لها.
  title       String
  description String?        @db.Text
  /// مفتاح القاموس ومتغيّراته بدل النصّ الجاهز - لنفس سبب `DailyTask`:
  /// البند يُولَّد مرّة بالكرون ويُقرأ مراراً، فتخزين النصّ المترجَم كان
  /// يثبّت لغة لحظة التوليد على القارئ. يُترجَم وقت العرض بلغة القارئ.
  titleKey    String?
  titleVars   Json?
  descKey     String?
  descVars    Json?

  // رابط اختياري - لما المستخدم يدوس على الإشعار في الجرس، يودّيه للصفحة
  // المناسبة (صفحة الاشتراك، صفحة القرارات، صفحة فحص الموقع، إلخ)
  linkUrl String?

  // لو البند ده ناتج من AutomationRule محدد (بند "تنفيذي" غالباً)
  relatedRuleExecutionId String?

  /// المحرّك الذي أنتج البند. حقل صريح لا استنتاج من linkUrl: محرّكان
  /// مختلفان (التسعير والمخزون) يشيران لنفس الصفحة، فالرابط لا يميّزهما.
  /// التجميع في صفحة القرارات مبنيّ عليه.
  source String @default("OTHER")

  /// الأثر المالي الشهري المقدَّر بعملة مساحة العمل - null حين لا يمكن
  /// حسابه بصدق. يُرتَّب به الأهمّ أولاً بدل ترتيب زمني أعمى.
  estimatedImpact Float?

  status     ActionFeedStatus @default(PENDING)
  resolvedAt DateTime?

  // تنفيذ حقيقي - نوع الإجراء + بيانات كافية تنفّذه، بدل "موافق" اللي
  // بيسجّل بس من غير فعل. null = اقتراح معلوماتي بس، مفيش تنفيذ آلي ليه
  actionType    String? // "SET_BID_STRATEGY_GOOGLE" | "SET_BID_STRATEGY_META" | "SET_BID_STRATEGY_TIKTOK"
  actionPayload Json? // {campaignId/adSetId/adGroupId, newStrategy, targetValue}

  // حالة القراءة في الجرس - منفصلة عمداً عن status (PENDING/APPLIED/
  // DISMISSED)، لأن إشعار حسابي زي "الخطة اتفعّلت" مالوش "قرار" يُتخذ
  // فيه أصلاً، لكن لسه محتاج يتقرا/متتقراش زي أي إشعار عادي
  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, read, createdAt])
}

enum ActionFeedType {
  SUGGESTION // بند تنفيذي - له Apply/Dismiss فعلي (توفير مصاريف، زيادة ميزانية..)
  ALERT // تنبيه - غالباً معلوماتي أو يحتاج مراجعة يدوية مش تنفيذ مباشر
  ACCOUNT // إشعار حسابي - اشتراك، تفعيل خطة، اكتمال فحص - مفيش قرار Apply/Dismiss ليه
}

enum ActionFeedStatus {
  PENDING
  APPLIED
  DISMISSED
}

// ==================== Experiments Lab ====================
// تسجيل كل تعديل (ميزانية/عناوين/صفحة هبوط) من لحظة حدوثه، وقياس أثره
// الحقيقي بعد فترة كافية - عشان نثبت إن تعديلات النظام فعلاً بتحسّن حاجة،
// مش مجرد ادعاء. التسجيل يبدأ فوراً من أول تعديل، لكن "الثقة" في النتيجة
// بتتأخر لحد ما تتوفر عينة كافية (نفس فلسفة AI Forecast بالظبط).

model ExperimentLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  changeType        ExperimentChangeType
  /// النصّ المعروض وقت التسجيل - احتياطيّ للصفوف القديمة وللوصف اليدوي
  /// الذي يكتبه المستخدم بنفسه (نصّ حرّ لا مفتاح له).
  description       String // "زيادة ميزانية كامبين X من 500 لـ 650 ريال"
  /// مفتاح القاموس ومتغيّراته - نفس قاعدة `DailyTask` و`ActionFeedItem`:
  /// التجربة تُسجَّل مرّة وتُقرأ مراراً، فتخزين النصّ المترجَم يجمّد لغة
  /// لحظة التنفيذ على القارئ. يُترجَم وقت العرض بلغة القارئ.
  descKey           String?
  descVars          Json?
  changedAt         DateTime             @default(now())
  relatedCampaignId String?

  // نافذة القياس - بتتحسب تلقائي (مثلاً 7 أيام قبل و7 أيام بعد)
  beforeMetricValue Float?
  afterMetricValue  Float?
  measuredMetric    String? // "cpl_verified" مثلاً - أي مقياس بيتقاس عليه الأثر

  // مستوى الثقة في النتيجة - بيتحدد تلقائي بناءً على حجم العينة المتاحة
  confidenceLevel ExperimentConfidence @default(INSUFFICIENT_DATA)

  // ==== قياس متعدد المؤشرات ====
  // النسخة الأولى كانت تقيس مؤشراً واحداً فقط. القرار الواحد قد يحسّن
  // مؤشراً ويضرّ آخر - القياس بمؤشر واحد يخفي ذلك تماماً.
  trackedMetrics String[] @default([]) // مفاتيح المؤشرات المطلوب قياسها
  metricResults  Json? // { key: { before, after, changePct } }

  // ==== مصدر التجربة ومسارها ====
  source         ExperimentSource @default(AUTO) // تلقائية عند تنفيذ قرار، أو يدوية
  status         ExperimentStatus @default(RUNNING)
  platform       Platform?
  note           String? // ملاحظة المستخدم (يدوية)
  windowDays     Int              @default(7) // نافذة القياس قبل/بعد
  measuredAt     DateTime?
  sourceActionId String? // بند القرار الذي أنشأ التجربة، إن وُجد

  createdAt DateTime @default(now())

  @@index([workspaceId, changedAt])
}

enum ExperimentChangeType {
  BUDGET
  AD_COPY
  LANDING_PAGE
  TARGETING
  BID_STRATEGY
  CREATIVE
  PAUSE
  AUTOMATION_RULE
  OTHER
}

enum ExperimentConfidence {
  INSUFFICIENT_DATA // لسه العينة مش كافية - النتيجة (لو ظاهرة) أولية بس
  PRELIMINARY // بداية اتجاه واضح، لكن لسه محتاج وقت أطول للتأكيد
  RELIABLE // عينة كافية (أيام + verified conversions) - النتيجة موثوقة
}

// ==================== توحيد التحويلات المتعددة لنفس الزائر ====================
// المشكلة: زائر واحد بيدوس على أكتر من زرار CTA (واتساب، اتصال، فورم) في
// نفس الزيارة - من غير الحل ده، كل ضغطة بتتحسب "تحويل" منفصل، فيتضخم
// الرقم رغم إنه عميل واحد بس. الحل: كل ضغطات الزائر في نفس الجلسة بتتسجل
// بنفس sessionId، ولما أول إشارة تحقق حقيقية توصل (رسالة واتساب فعلية،
// مكالمة مسجّلة، فورم اتبعت)، بيتربط كل أحداث الجلسة دي بتحويل واحد بس -
// أي إشارة تانية بعد كده لنفس الجلسة بتتسجل كـ"لمسة إضافية" للتحليل،
// مش تحويل جديد.

model CtaClickEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sessionId     String // معرف ثابت للزائر طول الزيارة (كوكي من الطرف الأول)
  gclid         String?
  clickPlatform Platform? // أنهي منصة الكليك ده جاي منها فعلياً - قبل كده كان مفروض جوجل بس بالسكوت
  campaignId    String?
  ctaType       CtaEventType
  userAgent     String?      @db.Text // إشارة كشف بوتات مجانية - المتصفح بيبعتها تلقائياً
  clickedAt     DateTime     @default(now())

  @@index([workspaceId, sessionId])
}

// السجل الوحيد المعتمد لـ"هل الجلسة دي اتحوّلت فعلياً قبل كده" - نفس مبدأ
// ProcessedWebhookEvent بالظبط (idempotency عن طريق unique constraint)،
// عشان الفحص يبقى آمن حتى لو إشارتين وصلوا في نفس اللحظة تقريباً (Race
// Condition) - قاعدة البيانات نفسها بترفض التكرار، مش الكود بيحاول يتأكد
// بنفسه بشكل غير آمن (زي "افحص الأول وبعدين اكتب" اللي ممكن يفشل تحت ضغط)
// تتبع محادثات ماسنجر (Click-to-Messenger) عشان نقدر نميّز ضغطة بالغلط
// عن تواصل حقيقي، ونزوّد verifiedConversions فعلياً بدل ما تفضل صفر.
// نفس مبدأ tracking الواتساب، لكن الإشارة هنا referral.ad_id (مؤكدة
// رسمياً من توثيق ميتا) بدل كود Ref نصي.
// اشتراك Web Push - كل جهاز/متصفح المستخدم فعّل فيه الإشعارات بييجيله
// صف مستقل هنا (نفس المستخدم ممكن يكون عنده كذا جهاز). مفيش تطبيق
// موبايل منفصل - Web Push بتشتغل من المتصفح مباشرة، بما فيها الموبايل.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text // مفتاح تشفير - جزء من بروتوكول Web Push القياسي
  auth      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

/// مفتاحُ ربطٍ لخادم MCP: يقرأ به ذكاءُ المشترك الخاصّ بياناتِ **مساحة عملٍ
/// واحدة**، قراءةً فقط. مربوطٌ بالمساحة لا بالحساب - مفتاحٌ مسرَّب يكشف
/// مساحةً واحدة لا كلّ عملاء الوكالة.
model McpToken {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// اسمٌ يكتبه المشترك ليعرف أيّ مفتاحٍ يُلغي («لابتوب الشغل»)
  label String

  /// 🔴 **مجزوءٌ لا نصّ.** يُعرَض مرّةً واحدة عند التوليد ثم لا يُسترجَع:
  /// قاعدةٌ مسرَّبة تكشف مفاتيح كلّ المشتركين لو كانت نصّاً.
  tokenHash String @unique
  /// آخر أربعة محارف - بها يميّز المشترك مفتاحه في الجدول بلا كشفه
  lastFour  String

  /// آخرُ نداءٍ وصل بهذا المفتاح. **يخدم غرضين:** مؤشّر «اشتغل» في شاشة
  /// التركيب، وإلغاءُ المنسيّ - تسعون يوماً بلا استعمالٍ تُنهيه.
  lastUsedAt DateTime?
  /// مدّةٌ اختيارية يضبطها من تُلزمه سياسةُ مؤسّسته. `null` = بلا انتهاء،
  /// وهو الافتراضيّ: مفتاحٌ ينتهي بصمتٍ يُفشل ذكاءَ المشترك في تطبيقٍ آخر
  /// والسببُ عندنا.
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([workspaceId])
  @@index([lastUsedAt])
}

model MessengerConversation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  psid       String // معرف الشخص عند ميتا (Page-Scoped ID) - فريد لكل شخص لكل صفحة
  adId       String? // من referral.ad_id - بيوصل مع أول رسالة بس
  campaignId String? // مُستنتج من adId عبر CampaignLink

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0) // عدد رسايل المستخدم نفسه

  assessed Boolean @default(false)
  verified Boolean @default(false)

  @@unique([workspaceId, psid])
  @@index([workspaceId, assessed])
}

model SessionConversion {
  id           String       @id @default(cuid())
  workspaceId  String
  sessionId    String
  firstCtaType CtaEventType // أول قناة فعلياً حققت التحويل (مفيد للتحليل: أي زرار بيقنع فعلاً)
  convertedAt  DateTime     @default(now())

  // رقم الهاتف (لو متاح من رسالة واتساب) - إشارة هوية أقوى من sessionId
  // اللي بيتغيّر لو نفس الشخص جه من جهاز تاني (موبايل بعد كمبيوتر مثلاً).
  // sessionId وحده كان بيمنع التكرار جوه نفس الزيارة بس، مش عبر الأجهزة
  phoneNumber String?

  @@unique([workspaceId, sessionId])
  @@index([workspaceId, phoneNumber])
}

enum CtaEventType {
  WHATSAPP
  CALL
  FORM
}

// ==================== مراقبة تغطية التتبع على مستوى الصفحة ====================
// السؤال اللي محدش كان بيقدر يجاوبه: "هل كود التتبع فعلاً موجود ومنصّب
// صح على كل صفحة هبوط عندي، ولا فيه صفحة نسيت أضيفه فيها؟" - فحص تقني
// مباشر (نجيب الصفحة ونفتش عن بصمة كود التتبع فيها)، مش افتراض.

model MonitoredPage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  url   String
  label String? // اسم يديه المستخدم للصفحة (مثلاً "صفحة هبوط الرياض")

  trackingDetected Boolean? // null = لسه ما اتفحصتش، true/false = نتيجة آخر فحص
  // أي أنظمة تتبع عُثر عليها بالاسم - الفحص السابق كان يعرف بصمة AdLoop
  // وحدها فيصنّف كل موقع عليه GTM/بيكسل كأنه بلا تتبع
  detectedSystems  String[]  @default([])
  adloopDetected   Boolean? // وسم AdLoop تحديداً - بدونه لا يعمل ربط النقرة بالمحادثة
  // نتائج SEO والأمان وروابط المحادثة - تُستخلص من نفس نداء الفحص
  auditResult      Json?
  lastCheckedAt    DateTime?
  lastError        String?   @db.Text // لو الفحص فشل لسبب تقني (الصفحة مش متاحة مثلاً)

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ==================== أداء على مستوى الإعلان الفردي (Creative-Level) ====================
// الفجوة الأهم اللي طلعت من تحليل الأسئلة: مدير أداء حقيقي بيسأل "أنهي
// صورة/فيديو/نص هو اللي بيجيب النتيجة؟" مش بس "الحملة كويسة؟". كل حاجة
// كانت متوقفة عند مستوى الحملة لحد دلوقتي.

model CreativeSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform     Platform
  campaignId   String // يربط بـ CampaignLink.externalCampaignId
  adId         String // معرف الإعلان الفردي عند المنصة
  // مطلوب لجوجل تحديداً عشان بناء اسم مصدر صحيح لإيقاف الإعلان
  // (customers/{id}/adGroupAds/{adGroupId}~{adId}) - مش مستنتج من
  // adId، لازم يتخزّن منفصل. null لباقي المنصات (مفهوم مختلف عندهم)
  adGroupId    String?
  // المجموعة الإعلانية الأمّ. الميزانية عند ميتا/تيك توك تُضبط هنا لا على
  // الإعلان الفردي - من دون هذا المعرّف، زرّ "Scale" على إعلان بعينه لا
  // يملك ما يزيده أصلاً، فيبقى اقتراحاً نصياً بلا تنفيذ.
  adSetId      String?
  adName       String?
  creativeType CreativeType
  headline     String?      @db.Text
  thumbnailUrl String?      @db.Text
  finalUrl     String?      @db.Text // رابط الوجهة الفعلي (Final URL) - نفس المصطلح المستخدم في جوجل نفسها

  date                DateTime @db.Date
  impressions         Int      @default(0)
  clicks              Int      @default(0)
  cost                Float    @default(0)
  rawConversions      Float    @default(0)
  // متحقق منها بس لو فيه ربط فعلي (UTM على مستوى الإعلان) - مش مضمون
  // دايماً، فبتفضل null لو مفيش رابط واضح بدل افتراض صفر خطأ
  verifiedConversions Int?

  // قيمة التحويلات (لحساب ROAS على مستوى الإعلان الفردي) - مؤكدة متاحة
  // لجوجل (metrics.conversions_value، حقل رسمي موثّق). ميتا وتيك توك
  // لسه مش متأكدين إن نفس التفصيل متاح على مستوى الإعلان الفردي عندهم
  // (محتاج بحث منفصل) - هتفضل null ليهم لحد ما يتأكد، مش تخمين برقم غلط
  conversionsValue Float?

  @@unique([workspaceId, platform, campaignId, adId, date])
  @@index([workspaceId, platform, campaignId])
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  TEXT
  RESPONSIVE
}

// ==================== فحص الموقع العميق (مخزّن، مش لقطة عابرة) ====================
model SiteScanResult {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  url            String
  competitorUrls String[] @default([]) // لحد منافسين مقارَنين معه، اختياري

  status SiteScanStatus @default(PENDING) // الفحص بطيء (صورة + AI + أداء) - بيتنفذ في الخلفية

  overallScore      Int?
  technicalSEOScore Int?
  domainTrustScore  Int?
  performanceScore  Int? // null لو PageSpeed فشل لأي سبب
  visualScore       Int? // null لو الصورة فشلت (خدمة Screenshot معطّلة/رابط غير متاح)

  // التقرير الكامل (كل الفئات + التركيب المترابط + بيانات المنافسين لو
  // موجودة) - بنخزنه JSON عشان نتجنب عشرات الأعمدة لكل فئة تدقيق فرعية،
  // ونقدر نعرضه/نطبعه لاحقاً بالظبط زي ما اتحسب وقتها
  fullReport   Json?
  errorMessage String? @db.Text

  scannedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workspaceId, scannedAt])
}

enum SiteScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ==================== تتبع أسبوعي لمعدل المشاهدة المتفاعلة (تعب الفيديو) ====================
// جدول منفصل عمداً عن TikTokVideoMetricSnapshot (اللي بيفضل صف واحد
// بيتحدّث فوق نفسه). "تعب الفيديو" محتاج مقارنة أسبوع بأسبوع حقيقية،
// مش رقم لحظي - نفس مبدأ AdSetDailyConversions بالظبط لكن أسبوعي هنا
// (تيك توك نفسها بتقيس Frequency على نافذة 7 أيام، فبنتبعها).
model TikTokWeeklyEngagement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  adId            String
  weekStart       DateTime @db.Date
  engagedViewRate Float    @default(0) // video_watched_6s ÷ impressions لنفس الأسبوع
  frequency       Float    @default(0) // من حقل frequency المباشر عند تيك توك

  @@unique([workspaceId, adId, weekStart])
  @@index([workspaceId, adId])
}

// ==================== معدل الخطّاف ومعدل الإكمال (تيك توك) ====================
// أهم مؤشر جودة فيديو خاص بالمنصة - مفيش له مكافئ مباشر في جوجل/ميتا.
// video_watched_2s (الخطّاف)، video_watched_6s (مشاهدة متفاعلة - تيك
// توك نفسها بتستخدم عتبة الـ6 ثواني للتحويل المُسند من غير كليك)
model TikTokVideoMetricSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  adId        String
  adName      String?
  impressions Int     @default(0)

  // Spark Ads (AUTH_CODE/TT_USER) مقابل إعلان عادي/Dark Post (CUSTOMIZED_USER)
  // - نفس مقاييس الخطّاف/الإكمال الموجودة، بس مُصنّفة حسب النوع. بنستخدمها
  // للمقارنة الحقيقية بدل الاعتماد على أرقام "صناعية" عامة (المصادر
  // نفسها مختلفة على الرقم - 37% مقابل 48% تحسّن تحويل، حسب المصدر)
  identityType String? // AUTH_CODE | TT_USER | CUSTOMIZED_USER | UNKNOWN

  hookRate        Float @default(0) // video_watched_2s ÷ impressions
  engagedViewRate Float @default(0) // video_watched_6s ÷ impressions
  completionRate  Float @default(0) // video_views_p100 ÷ impressions

  viewsP25  Int @default(0)
  viewsP50  Int @default(0)
  viewsP75  Int @default(0)
  viewsP100 Int @default(0)

  // جودة التعليقات - جزء بس من تحليل Spark Ads، مش ميزة منفصلة. بدون AI
  // خالص - قواعد ثابتة (regex) لكشف السبام، مش تصنيف مشاعر ذكاء اصطناعي
  totalComments   Int @default(0)
  flaggedComments Int @default(0) // سبام مؤكد بقواعد ثابتة، مش تخمين

  updatedAt DateTime @updatedAt

  @@unique([workspaceId, adId])
  @@index([workspaceId])
}

// ==================== أداء الحملات الديناميكية المرتبطة بكتالوج ====================
// أداء الحملة ككل فقط - أداء منتج بعينه جوه الحملة مش متاح كرؤية أصلية
// عند ميتا، محتاج نظام بيانات منفصل كامل (موثّق في التعليق أعلى الدالة)
model CatalogCampaignSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId   String
  productSetId String

  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  purchases   Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, campaignId])
  @@index([workspaceId])
}

// ==================== فورم الليدز داخل ميتا (Instant Forms) ====================
// "جودة العملاء من فورم ميتا الداخلي مقارنة بفورم موقعي؟" - بيانات حقيقية
// عن طريق webhook الـ leadgen، نفس نمط webhook واتساب بالظبط. محتاج
// صلاحيات إضافية (leads_retrieval, pages_show_list) - مسجّل في
// activation-checklist.md، نفس وضع طبقة جودة رسايل ماسنجر بالظبط.
model LeadFormSubmission {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform   Platform @default(META_ADS) // القيمة الافتراضية دي بس لتوافق الصفوف القديمة قبل إضافة الحقل
  leadgenId  String   @unique // معرف الليد الفريد عند المنصة - يمنع التكرار لو الويب هوك اتبعت مرتين
  formId     String
  adId       String?
  campaignId String?

  submittedAt DateTime
  fieldData   String?  @db.Text // JSON خام لإجابات العميل - بيانات حساسة، معروضة بحرص

  createdAt DateTime @default(now())

  @@index([workspaceId, submittedAt])
}

// ==================== أماكن ظهور الشبكة الإعلانية (Display/YouTube) ====================
// ملاحظة موثّقة رسمياً من جوجل: أماكن الظهور منخفضة النشاط بتتجمّع في
// صف "Other" واحد - مجموع الصفوف الفردية ممكن ميساويش مجموع الحملة الكلي
model DisplayPlacementSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId    String
  placement     String // رابط URL أو معرف فيديو يوتيوب أو "Other" للمجمّع
  displayName   String
  placementType String // WEBSITE | MOBILE_APP_CATEGORY | YOUTUBE_VIDEO | YOUTUBE_CHANNEL | إلخ
  date          DateTime @db.Date

  impressions Int   @default(0)
  clicks      Int   @default(0)
  cost        Float @default(0)
  conversions Float @default(0)

  @@unique([workspaceId, campaignId, placement, date])
  @@index([workspaceId, campaignId])
}

// ==================== أداء أنواع المطابقة (Broad/Phrase/Exact) ====================
// كل صف هنا بيمثّل "آخر 30 يوم مجمّعة" حسب نوع المطابقة، مُحدّثة يومياً -
// مش سجل تاريخي يوم بيوم لكل كلمة (الحجم كان هيكبر جداً من غير فايدة
// إضافية حقيقية للمقارنة بين الأنواع الثلاثة)
model MatchTypeSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  matchType  String // BROAD | PHRASE | EXACT | UNKNOWN
  date       DateTime @db.Date // تاريخ آخر تحديث، مش تاريخ حدث فردي

  impressions Int   @default(0)
  clicks      Int   @default(0)
  cost        Float @default(0)
  conversions Float @default(0)

  @@unique([workspaceId, campaignId, matchType, date])
  @@index([workspaceId, campaignId])
}

// ==================== أداء الجهاز والموقع الجغرافي ====================
// استعلامان منفصلان عمداً (مش مدموجين) - تجنّباً لمشكلة حذف الصفوف
// الموثّقة في GAQL عند دمج أكتر من بُعد تقسيم في استعلام واحد
model DevicePerformanceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  date       DateTime @db.Date
  device     String // MOBILE | DESKTOP | TABLET | CONNECTED_TV | OTHER

  impressions Int   @default(0)
  clicks      Int   @default(0)
  cost        Float @default(0)
  conversions Float @default(0)

  @@unique([workspaceId, campaignId, date, device])
  @@index([workspaceId, campaignId])
}

model GeoPerformanceSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  date       DateTime @db.Date
  geoTarget  String // اسم مورد geo_target_constant على مستوى الدولة

  impressions Int   @default(0)
  clicks      Int   @default(0)
  cost        Float @default(0)
  conversions Float @default(0)

  @@unique([workspaceId, campaignId, date, geoTarget])
  @@index([workspaceId, campaignId])
}

// ==================== أداء حملات يوتيوب (فيديو) ====================
// مقياس نجاح مختلف عن Search - نسبة مشاهدة، تفاعل، مش نقرات. الأرقام
// هنا كلها مشاهدات مدفوعة بس (العضوية/المكتسبة مش متاحة عن طريق الـ API)
model YoutubeMetricSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  date       DateTime @db.Date

  impressions    Int   @default(0)
  videoViews     Int   @default(0)
  videoViewRate  Float @default(0) // نسبة المشاهدة الكاملة (0-1)
  engagementRate Float @default(0)
  cost           Float @default(0)
  conversions    Float @default(0)

  @@unique([workspaceId, campaignId, date])
  @@index([workspaceId, campaignId])
}

// ==================== قناة إنفاق Performance Max الفعلية ====================
// من v23 (يناير 2026) - قبل كده كانت segments.ad_network_type بترجع
// MIXED دايماً لحملات PMax. البيانات متاحة بس من 1 يونيو 2025 فصاعداً.
model PmaxChannelSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  date       DateTime @db.Date
  channel    String // SEARCH | SEARCH_PARTNERS | GMAIL | YOUTUBE | DISPLAY | DISCOVER | MAPS | MIXED

  impressions Int   @default(0)
  clicks      Int   @default(0)
  cost        Float @default(0)
  conversions Float @default(0)

  @@unique([workspaceId, campaignId, date, channel])
  @@index([workspaceId, campaignId])
}

// ==================== أداء منتجات التسوق (Shopping/Merchant Center) ====================
// عبر shopping_product (المورد الحالي المستمر) مش Content API القديم
// اللي بيتقفل 18 أغسطس 2026
model ShoppingProductSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  itemId    String
  title     String?
  feedLabel String?

  hasIssues    Boolean @default(false)
  issuesDetail String? @db.Text // JSON خام لتفاصيل سبب الرفض/التقييد

  clicks      Int      @default(0)
  impressions Int      @default(0)
  conversions Float    @default(0)
  cost        Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, accountId, itemId])
  @@index([workspaceId, hasIssues])
}

// ==================== مكوّنات درجة الجودة (Quality Score) ====================
// "الجودة منخفضة" مش كافية - 3 مكوّنات منفصلة بتحدد السبب الفعلي:
// صلة الإعلان، تجربة صفحة الهبوط، نسبة النقر المتوقعة.
model QualityScoreSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId  String
  criterionId String // معرف الكلمة المفتاحية عند جوجل
  keywordText String?

  qualityScore          Int? // 1-10، الدرجة الكلية
  // المكوّنات الفرعية Enum نصي من جوجل (ABOVE_AVERAGE/AVERAGE/BELOW_AVERAGE)
  // مش رقم دقيق - جوجل بتخفي القيمة الفعلية عمداً
  adRelevance           String?
  landingPageExperience String?
  expectedCtr           String?

  updatedAt DateTime @updatedAt

  @@unique([workspaceId, campaignId, criterionId])
  @@index([workspaceId, campaignId])
}

// ==================== حماية عامة من إساءة الاستخدام (Rate Limiting) ====================
// للـ endpoints المفتوحة بدون تسجيل دخول (زي تتبع ضغطات CTA من صفحات
// الهبوط) - معندهاش "مستخدم" نربط بيه عداد زي نظام حصة الذكاء الاصطناعي،
// فبنتتبع بالـ IP نفسه بدل كده.
model RateLimitEntry {
  id          String   @id @default(cuid())
  identifier  String // عادة IP address، أو أي معرّف تاني حسب الـ endpoint
  endpoint    String // اسم الـ endpoint - نفس IP ممكن يكون له حدود مختلفة لكل endpoint
  windowStart DateTime @default(now())
  count       Int      @default(1)

  @@unique([identifier, endpoint, windowStart])
  @@index([identifier, endpoint])
}

// ==================== ملاحظات المستخدمين (لصاحب المنتج) ====================
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  category  String? // "bug" | "feature_request" | "other" - اختياري
  createdAt DateTime @default(now())
}

// ==================== سجل تدقيق أفعال الأدمن ====================
// لازم يجي مع أي قدرة قوية (زي View As أو تعليق حساب) - قوة كبيرة من
// غير تسجيل = خطر، مش راحة. بيسجل مين عمل إيه وإمتى ولمين.
model AdminAuditLog {
  id                String   @id @default(cuid())
  adminUserId       String
  action            String // "IMPERSONATE" | "SUSPEND_USER" | "UNSUSPEND_USER" | ...
  targetUserId      String?
  targetWorkspaceId String?
  details           String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([adminUserId, createdAt])
}

// ==================== سجل تشغيل الـ Cron اليومي ====================
// عشان نعرف "المزامنة إمبارح فشلت لكذا Workspace" بدل ما نكتشف بالصدفة
// لما عميل يشتكي إن بياناته واقفة
model CronRunLog {
  id              String   @id @default(cuid())
  /// 🔴 **أيُّ مهمّةٍ كتبت هذا الصفّ.** كان الجدول بلا اسمِ مهمّة، وكاتبُه
  /// الوحيد `sync-google-ads` - فلا يُعرَف من صفٍّ ما إن كانت النسخة
  /// الاحتياطية جرت أم لا، ولا يُفرَّق يومٌ توقّفت فيه مهمّةٌ عن يومٍ لم
  /// تُستدعَ فيه أصلاً. القيمة الافتراضية للصفوف السابقة وحدها.
  job             String   @default("sync-google-ads")
  runAt           DateTime @default(now())
  totalWorkspaces Int
  succeeded       Int
  failed          Int
  durationMs      Int?
  errors          String?  @db.Text // ملخص الأخطاء لو فيه، JSON مبسّط

  @@index([job, runAt(sort: Desc)])
}

// ==================== أدوار لوحة المالك ====================
//
// `isAdmin` بتفتح الباب، والدور بيحدّد إيه المسموح جوّه. الفصل مقصود:
// موظّف دعم يحتاج يشوف حساب عميل ويردّ عليه، من غير ما يقدر يهدي اشتراك
// أو يغيّر سعر أو يرقّي حساب لأدمن.
//
// الحقل **اختياري عمداً** بدل `@default`: قيمة افتراضية كانت هتدّي الدور
// لكل مستخدم في الجدول (مليون صف مش أدمن)، والـnull هنا معناها "ارجع
// لـisAdmin" - يعني كل حساب أدمن قائم دلوقتي بيفضل OWNER بلا أي ترحيل
// بيانات. الحسم كله في `resolveAdminRole` (lib/adminRole.ts).
enum AdminRole {
  OWNER // صاحب المنتج - كل شيء بما فيه المال والصلاحيات
  SUPPORT // دعم فنّي - عرض ومساعدة، بلا مال ولا صلاحيات
}

// ==================== مفاتيح تشغيل/إيقاف الميزات ====================
// مفتاح عام لكل المنتج (إيقاف مزامنة ميتا أثناء عطل مثلاً، أو فتح ميزة
// تجريبية) - منفصل تماماً عن حدود الباقة. التخصيص لحساب بعينه بيتم عبر
// `User.featureOverrides` مش هنا.
model FeatureFlag {
  key             String   @id
  description     String?
  enabledGlobally Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== أحداث الاشتراك ====================
//
// 🔴 **ده اللي بيخلّي "النمو والانكماش" رقم حقيقي مش استنتاج.** حالة
// الاشتراك الحالية (`User.subscriptionStatus`) بتقول الوضع دلوقتي بس -
// مبتقولش إمتى اتغيّر ولا من أنهي باقة لأنهي. من غير الجدول ده، معدّل
// الإلغاء والترقية/التخفيض بيتحسبوا بالتخمين من تواريخ متفرّقة.
model SubscriptionEvent {
  id     String                @id @default(cuid())
  userId String
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   SubscriptionEventType

  fromPlan    String?
  toPlan      String?
  /// بالسنت وبعملة الحدث - عشان تصنيف الحركة (نموّ/انكماش) يبقى حسابياً
  /// لا اجتهادياً. `null` للأحداث اللي مالهاش قيمة (إلغاء مثلاً).
  amountCents Int?
  currency    String?

  /// null = النظام (ويب هوك الدفع)، وقيمة = فعل إداريّ بيد أدمن.
  /// التفرقة دي هي الفرق بين "إيراد حقيقي" و"هدية" في تقارير الإيراد.
  actorAdminId String?
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

enum SubscriptionEventType {
  ACTIVATED
  RENEWED
  CANCELLED
  EXPIRED
  EXTENDED // تمديد يدويّ من الأدمن
  GIFTED // اشتراك ممنوح بلا دفع
  PLAN_CHANGED
  PAYMENT_FAILED
}

// ==================== رسائل الأدمن الفردية للعملاء ====================
// منفصل عن `MarketingEmailLog` عمداً: هدف ذاك منع تكرار رسالة الحملة
// الواحدة (قيد تفرّد على messageId)، وده مجرّد سجلّ إرسال يدويّ يتكرّر
// بطبيعته - نفس الأدمن ممكن يبعت لنفس العميل عشر مرّات بعشر رسائل.
model AdminEmailLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String
  subject     String
  body        String   @db.Text
  sentAt      DateTime @default(now())

  @@index([userId, sentAt])
}

// ==================== أيام النشاط الفعليّ ====================
//
// 🔴 `User.lastActiveAt` طابع زمنيّ **واحد بيتكتب فوق نفسه** - بيجاوب
// "آخر مرّة دخل إمتى" ومش قادر يجاوب "كام حساب نشط النهاردة/الأسبوع ده".
// صفّ واحد لكل مستخدم في اليوم بيحوّل السؤال ده لعدّة بسيطة.
model UserActivityDay {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  @@unique([userId, date])
  @@index([date])
}

// ==================== استخدام الميزات ====================
// سجلّ عامّ خفيف: مفتاح الميزة + مين + إمتى. الميزات المدفوعة بالذكاء
// الاصطناعي عندها عدّادات خاصة أصلاً على User، لكن باقي المنتج مفيهوش
// أي قياس - من غير الجدول ده، "أنهي ميزة بتتستخدم فعلاً" سؤال بلا إجابة.
model FeatureEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  key         String // "scale_kill_apply" | "report_generated" | ...
  createdAt   DateTime @default(now())

  @@index([key, createdAt])
  @@index([userId, createdAt])
}

// ==================== لقطة استهلاك يومية ====================
//
// عدّادات الاستهلاك على `User` بتتصفّر شهرياً/بالساعة في مكانها، يعني
// مفيش تاريخ يُرسم منه اتجاه. اللقطة اليومية دي (بيكتبها الكرون قبل
// التصفير) هي اللي بتحوّل "الاستهلاك دلوقتي" إلى "الاستهلاك عبر الزمن".
model AdminUsageSnapshot {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  aiRefreshCount    Int   @default(0)
  imageQualityCount Int   @default(0)
  siteScanCount     Int   @default(0)
  aiCreditsLeft     Int   @default(0)
  spendUsd          Float @default(0)
  verifiedConv      Int   @default(0)

  @@unique([userId, date])
  @@index([date])
}

// ==================== أداء المجموعات الإعلانية في ميتا (Lookalike/جمهور) ====================
// بديل ميتا لمفهوم "عرض الجمهور" في جوجل - هنا الاستهداف بيتحدد على مستوى
// المجموعة الإعلانية نفسها، مش عرض منفصل.
model MetaAdSetSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId    String
  adSetId       String
  adSetName     String?
  targetingType String // LOOKALIKE | CUSTOM_AUDIENCE | CORE | UNKNOWN

  // استراتيجية المزايدة - bid_strategy على مستوى الحملة نفسها، لكن
  // bid_amount (القيمة الفعلية) على مستوى المجموعة الإعلانية - معمارية
  // مختلفة عن جوجل (اللي فيها الهدف والقيمة على نفس المستوى)
  bidStrategyType String?
  bidAmount       Float?

  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  conversions Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, campaignId, adSetId])
  @@index([workspaceId, campaignId])
}

// ==================== تتبع يومي لتحويلات المجموعة الإعلانية ====================
// جدول منفصل عمداً عن MetaAdSetSnapshot (اللي بيفضل صف واحد بيتحدّث فوق
// نفسه - مستخدم في فحص استراتيجية المزايدة الحالي، تغييره كان هيبوّظه).
// هنا بالذات محتاجين تفصيل يومي حقيقي عشان حساب "فترة التعلّم" (قاعدة
// ميتا الموثّقة: ~50 حدث تحسين خلال 7 أيام بالظبط، مش تقريب من مجموع أكبر)
model AdSetDailyConversions {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  adSetId     String
  date        DateTime @db.Date
  conversions Float    @default(0)

  @@unique([workspaceId, adSetId, date])
  @@index([workspaceId, adSetId])
}

// ==================== أداء شرائح الجمهور ====================
// ملاحظة نطاق مهمة: البيانات هنا موجودة بس للحملات اللي جوجل بترجع لها
// بيانات جمهور موثوقة فعلياً (Display/YouTube/RLSA) - حملات Search
// العادية مش هيبقى ليها صفوف هنا، وده قيد من جوجل نفسها مش نقص في المزامنة.
model AudienceSegmentSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId    String
  criterionId   String // معرف الجمهور نفسه عند جوجل
  criterionType String? // USER_LIST | USER_INTEREST | ... إلخ

  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  conversions Float    @default(0)

  @@unique([workspaceId, campaignId, criterionId, date])
  @@index([workspaceId, campaignId])
}

// ==================== سعر الصرف اليومي ====================
// مش مربوط بـ Workspace معين - سعر الصرف نفس القيمة لكل الحسابات، فبيتسجل
// مرة واحدة عامة. الـ API المجاني (open.er-api.com) معندوش بيانات تاريخية،
// فبنبني الأرشيف بنفسنا بتسجيل يومي، من النهاردة وطالع.
model ExchangeRateSnapshot {
  id           String   @id @default(cuid())
  fromCurrency String // مثلاً "USD" (عملة حساب جوجل الإعلاني)
  toCurrency   String // مثلاً "SAR" (عملة استهداف الـ Workspace)
  rate         Float
  date         DateTime @db.Date

  @@unique([fromCurrency, toCurrency, date])
}

// ==================== رابط تقرير مشاركة للعميل النهائي ====================
model SharedReportLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  token     String    @unique @default(cuid()) // جزء من الرابط العام - عشوائي وطويل كفاية يصعب تخمينه
  active    Boolean   @default(true)
  expiresAt DateTime? // null = بلا انتهاء، أو تاريخ محدد لو حبيت تقفله بعدين

  createdAt DateTime @default(now())
}

// ==================== هدر الميزانية على مستوى مصطلح البحث ====================
// كانت مهمة "راجع Search Terms" مجرد تذكير مواعيد، من غير بيانات حقيقية
// وراها. دلوقتي بنسحب مصطلحات البحث الفعلية اللي جابت كليكات، عشان نقدر
// نقول بالظبط "المصطلح ده بالذات باعتلك X من غير ولا تحويل واحد".

model SearchTermSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId     String // يربط بـ CampaignLink.externalCampaignId
  searchTerm     String  @db.Text // النص الفعلي اللي الزائر بحث بيه
  matchedKeyword String? @db.Text // الكلمة المفتاحية اللي أنت حطيتها واللي طابقت البحث ده

  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0)
  conversions Float    @default(0)

  @@unique([workspaceId, campaignId, searchTerm, date])
  @@index([workspaceId, campaignId])
}

// ==================== عروض محفوظة للجداول (زي Google Ads Column Sets) ====================
model SavedView {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String? // null = عرض عام لكل مساحات العمل، أو مخصص لواحدة بعينها
  pageKey     String // "campaigns" | "reports" | ... - أي صفحة الـ view ده بتاعها
  name        String // اسم يختاره المستخدم بنفسه
  config      Json // شكل الأعمدة/الفلاتر المختارة - حر الشكل حسب الصفحة
  createdAt   DateTime @default(now())

  @@index([userId, pageKey])
}

// ==================== المنتجات (لمحرك التسعير - إيكومرس) ====================
// كان محرك حساب التسعير (lib/ecommerceMetrics.ts) مبني بالكامل من غير أي
// مكان يخزن فيه بيانات المنتج الفعلية - فجوة حقيقية، مش تصميم مقصود.

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                 String
  sku                  String? // لمطابقة عناصر الطلب الحقيقية من سلة (order.items[].sku) - لازم يتظبط يدوي عشان الربط يشتغل
  // معرّف المنتج لدى منصة الإيكومرس - يلزم للمنصات التي لا تدعم التحديث
  // بالـSKU مباشرة (شوبيفاي، ووكومرس، زد)
  externalProductId    String?
  externalVariantId    String? // شوبيفاي تحفظ السعر على المتغيّر لا المنتج
  currentPrice         Float
  cogs                 Float   @default(0)
  outboundShippingCost Float   @default(0)
  returnShippingCost   Float   @default(0)
  rtoRatePct           Float   @default(0)
  avgAdCostPerOrder    Float   @default(0) // بيتحدث دورياً من بيانات الحملات، أو يدوي لحد ما نربطه أوتوماتيك

  desiredMarginPct       Float @default(20)
  paymentGatewayFeePct   Float @default(2.85)
  paymentGatewayFixedFee Float @default(3)

  // ==== تكاليف حقيقية لم تكن ضمن المعادلة ====
  packagingCost     Float @default(0) // التغليف والتجهيز لكل طلب
  handlingCost      Float @default(0) // المناولة/التخزين المنسوب للطلب
  codFeePct         Float @default(0) // عمولة الدفع عند الاستلام (شائعة في السوق العربي)
  restockingLossPct Float @default(0) // نسبة ما لا يعود قابلاً للبيع من المرتجعات

  /// 🔴 **المتجر الذي جاء منه هذا المنتج - وبدونه يُكتب سعرُ منتجٍ في
  /// متجرٍ آخر.** كان `priceSync` يأخذ **أوّل** ربطٍ له صلاحية كتابة في
  /// المساحة، وهو صحيحٌ ما دام المتجر واحداً. فإذا صارا اثنين، صار تعديلُ
  /// سعر منتجٍ من متجر «أ» يكتبه في متجر «ب» - كتابةٌ حقيقية بمالٍ حقيقيّ
  /// في المكان الخطأ، ولا يظهر إلّا حين يسأل التاجر لماذا تغيّر سعرٌ لم
  /// يمسّه أحد.
  ///
  /// اختياريّ: منتجاتٌ تُضاف يدوياً لا متجر لها، وهي تُدار عندنا وحدنا.
  connectionId String?
  connection   EcommerceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // ==== المخزون - أساس قواعد "أوقف الإعلان قبل نفاد الرصيد" ====
  // يُحدَّث تلقائياً من منصة الإيكومرس المربوطة عند توفّرها، أو يدوياً.
  stockQuantity     Int? // null = غير متتبَّع (لا تُطبَّق قواعد المخزون)
  lowStockThreshold Int       @default(10) // "قرب يخلص" - يُضبط لكل منتج
  stockUpdatedAt    DateTime?
  stockSource       String? // "SALLA" | "SHOPIFY" | "MANUAL"

  cogsLastUpdatedAt DateTime           @default(now()) // لفحص "التكلفة قديمة" في diagnoseMarginIssue
  createdAt         DateTime           @default(now())
  saleEvents        ProductSaleEvent[]

  @@index([workspaceId])
}

// طلبات حقيقية على مستوى المنتج الفردي - كانت الفجوة الحقيقية اللي منعت
// runFullPricingSafetyNet/explainRoasGap من الشغل بدقة (كنا بس عندنا
// إجمالي الطلبات على مستوى الـWorkspace، مش مربوط بمنتج بعينه)
model ProductSaleEvent {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ربط السطر بالطلب الأب. بدونه لا نعرف "كم منتجاً في الطلب الواحد"
  // ولا نستطيع تحليل السلة أو ربط المنتج بالعميل - وهي أساس فرص
  // البيع المتقاطع والباقات
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quantity   Int
  revenue    Float // إجمالي قيمة السطر ده في الطلب (مش سعر الوحدة × الكمية بالضرورة لو فيه خصم)
  returned   Boolean  @default(false)
  occurredAt DateTime

  @@index([productId, occurredAt])
  @@index([orderId])
}

// ==================== دعم العملاء (شات مبني على الإيميل) ====================
// شات بين العميل وصاحب المنتج: العميل يفتح محادثة (اسم/إيميل/موبايل/دولة/
// موضوع/تفاصيل + صور)، توصل إيميل لصاحب المنتج، والرد يترد من لوحة المالك
// ويظهر للعميل في نفس الشات. محفوظ في قاعدة البيانات (يفضل حتى لو قفل الجهاز).
model SupportThread {
  id        String           @id @default(cuid())
  userId    String? // لو العميل مسجّل دخول - عشان نلاقي محادثته عبر الأجهزة
  name      String
  email     String
  phone     String?
  country   String?
  subject   String
  status    String           @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
  /// موضوع المشكلة، يختاره الأدمن عند الرد/الإغلاق - قائمة مغلقة في
  /// `lib/supportCategories.ts`. من غيره "أكتر مشكلة بتتكرر" سؤال بلا
  /// إجابة: نصّ الرسالة حرّ، وتصنيفه آلياً محتاج تحليل لغة لا داعي له.
  category  String?
  /// لحظة الإغلاق الصريح. `updatedAt` مش بديل: بيتحرّك مع كل رد، فزمن
  /// الحل المحسوب منه بيبقى غلط لأي محادثة اتردّ عليها بعد الإغلاق.
  closedAt  DateTime?

  // ═══ صندوقٌ واحد لكلّ القنوات ═══
  //
  // الجدول ده كان لشات الموقع وحده. وضمُّ واتساب وماسنجر جنبه مش توسيعاً
  // تجميلياً: **الرسالة هي الرسالة**، والفصلُ في صناديق منفصلة معناه إنّ
  // نفس العميل بيبقى تلات محادثات مالهاش تاريخ مشترك، وإنّ كلّ ميزة
  // (تعيين، وسم، بحث، إغلاق) تتبني تلات مرّات.

  /// WEB | WHATSAPP | MESSENGER - نصٌّ لا enum: قناةٌ جديدة (إنستجرام
  /// مثلاً) تتضاف بصفٍّ لا بترحيلٍ يقفل الجدول.
  channel    String  @default("WEB")
  /// معرّفُ المحادثة عند المنصّة: رقمُ الواتساب، أو PSID ماسنجر. هو
  /// المفتاح اللي بيربط رسالةً واردة بمحادثةٍ قائمة بدل ما يفتح واحدة
  /// جديدة مع كلّ رسالة.
  externalId String?

  /// مثبَّتة فوق القائمة - قرارُ صاحب الصندوق، مستقلّ عن الحداثة.
  pinned        Boolean   @default(false)
  /// آخرُ لحظةٍ فتح فيها الدعمُ المحادثة. مقارنتها بـ`lastMessageAt` هي
  /// **كلُّ** منطق المقروء/غير المقروء - بلا عدّادٍ يتحرّك في مكانين
  /// فيفترقان.
  readByAdminAt DateTime?
  /// لحظةُ آخر رسالة. `updatedAt` مش بديل: بيتحرّك مع أيّ تعديل (وسم،
  /// تعيين، تثبيت)، فترتيبُ "الأحدث فوق" كان بيقفز بأفعالٍ مش رسائل.
  lastMessageAt DateTime  @default(now())

  /// المسؤول عن المحادثة. `null` = غير معيَّنة.
  assignedToId String?
  assignedTo   User?   @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// وسومٌ حرّة - غير `category` المغلقة: دي للتقارير، ودي لتنظيم
  /// الصندوق («يستنّى العميل»، «باگ»، «فاتورة»).
  tags String[]

  /// حذفٌ ناعم: المحادثة بتختفي من الصندوق ويفضل نصُّها للتدقيق. الحذفُ
  /// الصلب بيمسح تاريخَ شكوى عميلٍ ممكن يرجع يسأل عنها.
  deletedAt DateTime?

  /// وصولُ الرسالة الواردة لمحادثتها بدل فتحِ واحدةٍ جديدة كلّ مرّة.
  @@unique([channel, externalId])
  @@index([userId])
  /// ترتيبُ الصندوق: المثبَّت أوّلاً ثمّ الأحدث - وبلا المحذوف.
  @@index([deletedAt, pinned, lastMessageAt])
  @@index([assignedToId])
}

/// ربطُ قناةِ مراسلة (واتساب بيزنس / ماسنجر) بصندوق الدعم.
///
/// **الجدول ده هو الفرق بين «الكود جاهز» و«الميزة شغّالة».** الربط كان
/// هيبقى متغيّراتِ بيئة، ومعناه إنّ تغييرَ رقمٍ أو تجديدَ توكن يتطلّب
/// نشرة - ونشرةٌ عشان رقم تليفون مش إعداداً، ده احتجاز.
///
/// والسرُّ مشفَّرٌ بنفس آلية توكنات المنصّات الإعلانية (`lib/encryption.ts`):
/// توكنُ واتساب بيقدر يبعت باسم البيزنس لأيّ حدّ كلّمه، فتخزينُه خاماً
/// أخطر من توكن قراءة.
model ChannelConnection {
  id          String  @id @default(cuid())
  /// WHATSAPP | MESSENGER - نفس قائمة `lib/inbox.ts`
  channel     String
  /// `phone_number_id` عند واتساب، أو معرّفُ الصفحة عند ماسنجر
  externalId  String
  /// اسمٌ يقرؤه صاحبه: الرقم نفسه أو اسمُ الصفحة
  label       String
  /// مشفَّر AES-256-GCM - لا يُقرأ إلّا في `lib/channels/outbound.ts`
  accessToken String  @db.Text
  /// سرُّ التحقّق من توقيع الويب هوك، مشفَّرٌ كذلك
  appSecret   String? @db.Text
  /// رمزُ التحقّق وقت ربط الويب هوك عند ميتا
  verifyToken String?

  /// إيقافٌ بلا حذف: الحذفُ بيخلّي الرسائل الواردة تفتح محادثاتٍ بلا
  /// طريقِ ردّ، والإيقافُ بيوقف الاتنين معاً.
  active      Boolean   @default(true)
  /// آخرُ ويب هوك وصل فعلاً - الدليلُ الوحيد إنّ الربط شغّال، لا إنّه
  /// «متحفوظ». غيابُه بعد الربط عطبُ إعداد يتقال صراحةً في الواجهة.
  lastEventAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([channel, externalId])
  @@index([channel, active])
}

model SupportMessage {
  id          String        @id @default(cuid())
  threadId    String
  thread      SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromSupport Boolean       @default(false) // true = رد من صاحب المنتج
  body        String        @db.Text
  imageUrls   String[] // مرفقات (روابط Vercel Blob)
  readByUser  Boolean       @default(true) // رسائل الدعم تبدأ false لحد ما العميل يشوفها
  createdAt   DateTime      @default(now())

  /// معرّفُ الرسالة عند المنصّة - **حارسُ التكرار**. ميتا بتعيد إرسال
  /// الويب هوك لو ماردّيناش بسرعة، فبلا المفتاح ده الرسالة الواحدة
  /// بتتكتب مرّتين وتلاتة في المحادثة.
  externalId String? @unique

  /// مين ردّ من الفريق - `null` للرسالة الواردة أو لردٍّ قديم قبل الحقل.
  authorAdminId String?

  @@index([threadId])
  @@index([threadId, createdAt])
}

enum ExperimentSource {
  AUTO // أُنشئت تلقائياً عند تنفيذ قرار أو قاعدة أتمتة
  MANUAL // أنشأها المستخدم بنفسه
}

enum ExperimentStatus {
  RUNNING // نافذة القياس لم تكتمل بعد
  MEASURED // اكتملت وتم حساب النتيجة
  INCONCLUSIVE // اكتملت لكن البيانات غير كافية للحكم
}

/// ربط متجر إيكومرس بمساحة عمل. سرّ الويب هوك مشفّر بنفس آلية توكنات
/// المنصات الإعلانية - لا يُخزَّن أي سرّ بنص صريح.
model EcommerceConnection {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform        Platform
  storeName       String?
  storeUrl        String?
  /// المشفَّر دائماً. ومعناه يختلف بحسب المنصّة: سرُّ توقيعٍ نولّده نحن
  /// (ووكومرس)، أو سرٌّ تولّده المنصّة وينسخه المشترك إلينا (شوبيفاي،
  /// سلّة، إيزي أوردرز)، أو **كلمة مرور** المصادقة الأساسية (زد).
  /// المرجع الواحد لأيّها: `lib/ecommerce/webhookAuth.ts`.
  webhookSecret   String?  @db.Text // مشفّر
  /// اسم مستخدم المصادقة الأساسية - **لزد وحدها**، فهي المنصّة الوحيدة
  /// التي لا توقّع الويب هوك أصلاً. ليس سرّاً فلا يُشفَّر، وبدونه لا
  /// يُقبل ربط زد لأنّ ويب هوكاً بلا مصادقة يقبل من أيّ أحد.
  webhookUsername String?
  // توكن API للكتابة (تحديث الأسعار). منفصل عن سرّ الويب هوك: الأول
  // للاستقبال والتحقق، وهذا للكتابة إلى المتجر - وصلاحياتهما مختلفة.
  apiToken        String?  @db.Text // مشفّر
  /// معرّف المتجر لدى المنصّة كما يصل في الويب هوك نفسه: نطاق
  /// `myshopify.com` لشوبيفاي، وعنوان الموقع لووكومرس، ومعرّف التاجر
  /// لسلّة. **هو مفتاح حسم صاحب كلّ ويب هوك** - راجع
  /// `lib/ecommerce/resolveStore.ts`. يبقى `null` حتى أوّل رسالةٍ يصحّ
  /// توقيعها، فيُوسَم بها تلقائياً ولا يُمسح بعدها.
  storeIdentifier String?
  apiSecret       String?  @db.Text // مشفّر - ووكومرس تستخدم مفتاح + سرّ
  canWritePrices  Boolean  @default(false) // هل التوكن يسمح بالكتابة فعلاً
  active          Boolean  @default(true)

  lastOrderAt    DateTime?
  ordersReceived Int       @default(0)

  products      Product[]
  orders        Order[]
  campaignLinks CampaignLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// متجرٌ واحدٌ لا يملكه مساحتا عمل. بدون هذا القيد يستطيع مشتركٌ أن
  /// يسجّل معرّف متجر غيره فتُقسَم مبيعاته بين حسابين - والقيد يجعلها
  /// غلطةً تُرفض عند الكتابة لا خطأً يُكتشف من تقريرٍ ناقص.
  /// (الـ`null` لا يتعارض في Postgres، فتتعايش الروابط غير الموسومة.)
  @@unique([platform, storeIdentifier])
  /// 🔴 **سقط القيد `@@unique([workspaceId, platform])`.** كان يحصر
  /// المساحة في متجرٍ واحدٍ لكلّ منصّة، فتاجرٌ له متجرا سلّة (علامتان،
  /// أو تجزئة وجملة) لا يستطيع ربط الثاني: مسار الحفظ `upsert` على
  /// المفتاح نفسه، فيكتب الثاني **فوق** الأوّل بصمت - يظنّ أنّه أضاف
  /// متجراً وقد استبدل متجره.
  ///
  /// وسقوطه يعني أنّ «متجر هذه المنصّة» لم يعد سؤالاً له جوابٌ واحد:
  /// `Product.connectionId` و`Order.connectionId` هما ما يفصل بينهما.
  @@index([workspaceId, platform])
  @@index([platform, active])
}

// ==================== طبقة اللمسات (Multi-Touch Attribution) ====================
//
// السياق: كان النظام يعرف "نقرة واحدة" فقط (UnmatchedClick) ثم "تحوّل أو لا".
// هذا كافٍ لإسناد آخر لمسة فحسب. رحلة العميل الحقيقية متعددة اللمسات:
// إعلان يوتيوب ← بحث جوجل ← إعلان ميتا ← رسالة واتساب ← طلب. من دون
// تسجيل كل لمسة، أي نموذج إسناد غير آخر-لمسة مستحيل رياضياً - لا تنقصنا
// المعادلة، تنقصنا البيانات نفسها.
//
// Touchpoint = كل احتكاك مسجّل للزائر نفسه (visitorId ثابت من الطرف الأول،
// لا كوكي طرف ثالث - لهذا لا تكسره قيود iOS/Safari).

model Touchpoint {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // المعرّف الثابت للزائر عبر الزيارات كلها (كوكي طرف أول أو معرّف مُهشَّم
  // من الهاتف/البريد عند توفّره). هو العمود الفقري لربط اللمسات ببعضها.
  visitorId String
  sessionId String? // زيارة واحدة داخل رحلة الزائر

  kind    TouchpointKind
  channel TouchpointChannel

  platform   Platform?
  campaignId String?
  adSetId    String? // مجموعة إعلانية/مجموعة إعلانات - مطلوبة لإسناد على مستوى المجموعة
  adId       String?

  // معرّف النقرة من المنصة نفسها - أقوى إشارة إسناد على الإطلاق، ومطلوب
  // حرفياً لرفع التحويل لاحقاً إلى جوجل (gclid) وميتا (fbclid ← fbc)
  clickId     String?
  source      String? // utm_source
  medium      String? // utm_medium
  campaignTag String? // utm_campaign - الاسم النصّي لا المعرّف
  referrer    String? @db.Text
  landingPath String? @db.Text

  // إشارات جانب الخادم - تُلتقط من الطلب نفسه لا من المتصفح، فلا تُحجب
  ipAddress String?
  userAgent String? @db.Text

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([workspaceId, visitorId, occurredAt])
  @@index([workspaceId, occurredAt])
}

enum TouchpointKind {
  AD_CLICK // نقرة إعلان مدفوع - أقوى لمسة
  AD_VIEW // ظهور/مشاهدة مُسجَّلة (Engaged View) - أضعف، تُرجَّح أقل
  SITE_VISIT // زيارة عضوية/مباشرة
  CRM_EVENT // حدث من نظام العميل (رد مبيعات، اجتماع، عرض سعر)
  MESSAGE // رسالة واتساب/ماسنجر واردة
}

enum TouchpointChannel {
  PAID_SEARCH
  PAID_SOCIAL
  PAID_VIDEO
  ORGANIC_SEARCH
  ORGANIC_SOCIAL
  DIRECT
  REFERRAL
  EMAIL
  CRM
  OTHER
}

// حدث تحويل حقيقي - العملة التي تُقسَّم على اللمسات في نماذج الإسناد.
// منفصل عن AttributionResult عمداً: ذاك سجل قرار المحرّك الاحتمالي لمحادثة
// واحدة، وهذا الحدث التجاري نفسه (طلب/عميل دافع) بقيمته النقدية.

model ConversionEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  visitorId  String?
  // معرّف الحدث لدى المصدر (رقم الطلب، معرّف المحادثة) - يمنع الازدواج
  externalId String
  eventName  String // "Purchase" | "Lead" | "QualifiedLead" | "Subscribe"
  occurredAt DateTime

  value    Float  @default(0)
  currency String @default("SAR")

  // هل تحقّق فعلاً (رسالة حقيقية/طلب مؤكد) أم رقم أعلنته المنصة فقط.
  // هذا الحقل تحديداً هو ما يجعل ما نرفعه للمنصات أنظف مما تعرفه بنفسها.
  verified Boolean @default(false)

  // ==== بيانات المطابقة - مُهشَّمة SHA-256 قبل التخزين، لا نصاً صريحاً ====
  emailHash       String?
  /// تهشيم هاتف **ميتا**: أرقامٌ بلا علامة `+`.
  phoneHash       String?
  /// تهشيم هاتف **جوجل وتيك توك**: E.164 كاملةً بعلامة `+` (C-4).
  ///
  /// عمودان لرقمٍ واحد لأنّ المنصّات لا تتّفق على صيغة ما قبل التهشيم:
  /// ميتا توثّق أرقاماً مجرّدة، وجوجل وتيك توك توثّقان E.164 صراحةً.
  /// والتهشيم لا يغفر محرفاً - فكان الرقم المرسَل إليهما لا يطابق أحداً.
  /// ولا يُشتَقّ أحدهما من الآخر لاحقاً: الرقم الخام **لا يُخزَّن** عمداً
  /// (خصوصية)، فيلزم حسابهما معاً لحظة الابتلاع وهو متاح.
  phoneHashE164   String?
  firstNameHash   String?
  lastNameHash    String?
  cityHash        String?
  countryHash     String?
  externalUserId  String? // معرّف العميل لدى المتجر، مُهشَّم
  clientIpAddress String?
  clientUserAgent String? @db.Text
  fbp             String? // كوكي متصفح ميتا
  fbc             String? // fbclid مُحوَّل لصيغة ميتا الرسمية
  gclid           String?
  ttclid          String?

  /// من أين جاء هذا التحويل: `"website"` | `"whatsapp"` | `"messenger"`.
  ///
  /// 🔴 كان كلّ حدثٍ يُرفع إلى ميتا بـ`action_source: "website"` (C-8)،
  /// ومحادثةُ واتساب ليست زيارةَ موقع. وميتا توثّق لإعلانات النقر-إلى-واتساب
  /// مصدراً آخر (`business_messaging` مع `messaging_channel`)، فالحدث المرسَل
  /// بالمصدر الخاطئ **يُقبَل ولا يُنسَب إلى الإعلان** - فلا تتعلّم الخوارزمية
  /// منه، وهو بالضبط ما جاء المنتج ليصلحه.
  sourceKind String @default("website")

  /// معرّف نقرة إعلان النقر-إلى-واتساب. ترسله ميتا في `referral.ctwa_clid`
  /// على أوّل رسالة، وهو **الرابط الوحيد** بين المحادثة والإعلان الذي جاء
  /// بها. وحدثٌ بلا هذا المعرّف يُعالَج ولا يُربَط بإعلانٍ إطلاقاً.
  ctwaClid String?

  // جودة المطابقة 0-10 - الرقم الذي يحدّد فعلياً هل ستنجح المنصة في ربط
  // الحدث بمستخدم لديها أم سيُهمَل. يُحسب من عدد وقوة المعرّفات المتاحة.
  matchQualityScore Float?

  // نسخة مجمّدة من مسار اللمسات لحظة التحويل - لأن اللمسات قد تُحذف
  // لاحقاً بسياسة الاحتفاظ، بينما نتيجة الإسناد يجب أن تبقى قابلة للتدقيق
  pathSnapshot Json?

  createdAt DateTime            @default(now())
  syncLogs  ConversionSyncLog[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, verified, occurredAt])
}

// سجل رفع كل حدث إلى كل منصة - منفصل لأن الحدث الواحد يُرفع لأكثر من منصة
// وقد ينجح لدى واحدة ويفشل لدى أخرى. من دون هذا الفصل، "تمت المزامنة"
// تصبح ادّعاءً لا يمكن التحقق منه.

model ConversionSyncLog {
  id                String          @id @default(cuid())
  workspaceId       String
  conversionEventId String
  conversionEvent   ConversionEvent @relation(fields: [conversionEventId], references: [id], onDelete: Cascade)

  platform          Platform
  status            ConversionSyncStatus @default(PENDING)
  attempts          Int                  @default(0)
  errorMessage      String?              @db.Text
  platformEventId   String? // معرّف الحدث لدى المنصة، للتتبّع لاحقاً
  matchQualityScore Float? // ما أعادته المنصة فعلاً إن أعادته
  sentAt            DateTime?
  createdAt         DateTime             @default(now())

  @@unique([conversionEventId, platform])
  @@index([workspaceId, status, createdAt])
}

enum ConversionSyncStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // لا يوجد معرّف مطابقة كافٍ لهذه المنصة - الرفع بلا فائدة
}

// ==================== سجل قرارات الإعلان (Scale / Hold / Pause) ====================
//
// السبب المعماري: القرار لا يكتمل بالتنفيذ. بعد أي زيادة ميزانية أو إيقاف،
// يجب ألّا نقترح شيئاً جديداً على الإعلان نفسه قبل أن نرى نتيجة ما فعلناه -
// وإلّا راكمنا تغييرات فوق بعضها ولم نعرف أيها أثّر. هذا الجدول هو البوابة
// الزمنية (4 أيام) ومصدر التقييم البعدي معاً.

model AdDecisionRecord {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform   Platform
  adId       String
  adName     String?
  campaignId String?
  adSetId    String?

  decision AdDecision
  reason   String     @db.Text // نص القاعدة التي أنتجت القرار وقتها

  appliedAt    DateTime @default(now())
  // لا يُقيَّم القرار ولا يُقترح غيره على الإعلان نفسه قبل هذا التاريخ
  reEvaluateAt DateTime

  /// 🔴 **الحلقةُ لم تكن مقفلة، والتعليقُ في `adDecisions.ts` كان يدّعي
  /// أنّها كذلك:** «يُعاد التقييم من الصفر بمقارنة ما قبل بما بعد».
  ///
  /// والمقارنةُ كانت مستحيلة: لم يكن يُحفَظ أيُّ رقمٍ من لحظة القرار، فلا
  /// مرجعَ يُقارَن به بعد انتهاء التهدئة. فالنظام يقترح زيادةً، ثمّ يقترح
  /// أخرى بعد أربعة أيّام، **ولا يعرف أنّ الأولى أضرّت** - وهو أخطر ما
  /// يمكن أن يفعله شيءٌ يحرّك ميزانيّات.
  ///
  /// يُلتقط هنا ما كان عليه الإعلان لحظةَ التنفيذ، فيُقاس أثرُ القرار عليه.
  cpaAtDecision         Float?
  conversionsAtDecision Int?

  // القيم قبل/بعد للتغيير الفعلي على المنصة (ميزانية مثلاً)
  previousValue Float?
  newValue      Float?

  // لقطة المقاييس قبل التنفيذ - أساس المقارنة بعد اكتمال النافذة
  metricsBefore Json?
  metricsAfter  Json?
  outcome       AdDecisionOutcome @default(PENDING_EVALUATION)
  evaluatedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([workspaceId, adId, appliedAt])
  @@index([workspaceId, outcome, reEvaluateAt])
}

enum AdDecision {
  SCALE
  HOLD
  PAUSE
}

enum AdDecisionOutcome {
  PENDING_EVALUATION
  IMPROVED
  UNCHANGED
  WORSENED
  INSUFFICIENT_DATA
}

// ==================== سجل تشغيل المزامنة ====================
//
// لم يكن في المنتج أي أثر مكتوب لعملية مزامنة: تُشغَّل، تنجح أو تفشل، ثم
// لا يبقى منها شيء. فتعذّر عرض "آخر مزامنة" أو سِجلّ نشاط أو صحة تكامل
// دون اختلاق أرقام. هذا الجدول هو مصدرها جميعاً.

model SyncRun {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform Platform
  status   SyncRunStatus
  trigger  SyncTrigger   @default(CRON)

  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  // عدد الصفوف المكتوبة فعلاً - يفرّق بين "نجحت ولم تجد جديداً" و"نجحت وجلبت"
  recordsWritten Int?
  errorMessage   String?   @db.Text

  @@index([workspaceId, startedAt])
  @@index([workspaceId, platform, startedAt])
}

enum SyncRunStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum SyncTrigger {
  MANUAL
  CRON
}

// ==================== العملاء والطلبات ====================
//
// لم يكن في المنتج جدول عميل ولا طلب إطلاقاً: كل ما نعرفه كان مجاميع
// يومية (MetricSnapshot) وأسطر بيع بلا طلب أب (ProductSaleEvent). هذا
// يكفي لقياس الربح، ولا يكفي إطلاقاً للإجابة عن "من يشتري مرة ثانية؟"
// أو "أي الطلبات تُلغى؟" - وهما سؤالان يقرّران أين يذهب المال.
//
// الخصوصية: لا يُخزَّن بريد ولا هاتف صريح. نُهشِّمهما SHA-256 لاستخدامهما
// كمُعرِّف ربط فقط، ونحتفظ بالاسم الأول ومقتطف مقنَّع للعرض. تحليل العملاء
// لا يحتاج معرفة هويتهم، يحتاج معرفة سلوكهم.

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform           Platform
  externalCustomerId String?

  emailHash   String?
  phoneHash   String?
  /// الاسم الأول فقط - كافٍ للعرض، وغير كافٍ للتعريف
  displayName String?
  city        String?
  country     String?

  firstOrderAt        DateTime?
  lastOrderAt         DateTime?
  ordersCount         Int       @default(0)
  totalSpent          Float     @default(0)
  /// ما ارتدّ فعلاً - العميل كثير الطلبات كثير المرتجعات ليس عميلاً جيداً
  totalReturned       Float     @default(0)
  returnedOrdersCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([workspaceId, platform, externalCustomerId])
  @@index([workspaceId, lastOrderAt])
  @@index([workspaceId, emailHash])
}

model Order {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform        Platform
  externalOrderId String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderedAt    DateTime
  total        Float
  shippingCost Float    @default(0)
  currency     String?

  /// الحالة الخام كما ترسلها المنصة - نحتفظ بها للتدقيق لا للمنطق
  rawStatus  String?
  state      OrderState @default(PLACED)
  isReturned Boolean    @default(false)
  itemCount  Int        @default(0)

  fulfilledAt   DateTime?
  /// الدفع عند الاستلام أهمّ إشارة مخاطرة في السوق العربي
  paymentMethod String?
  isCod         Boolean   @default(false)

  /// 0-100، محسوبة من إشارات حقيقية لا من نموذج مُدرَّب - يُشرح مصدرها في الواجهة
  fraudRiskScore   Float?
  fraudRiskReasons String[] @default([])

  createdAt  DateTime           @default(now())
  saleEvents ProductSaleEvent[]

  /// المتجر الذي وصل منه الطلب. أرقام الطلبات ليست عالمية - بل ليست
  /// فريدةً حتّى بين متجرَي التاجر الواحد على المنصّة نفسها، فكلٌّ يبدأ
  /// ترقيمه من عنده. وبدونه يُقرأ طلب متجره الثاني «مكرَّراً» فيُهمَل.
  connectionId String?
  connection   EcommerceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform, connectionId, externalOrderId])
  @@index([workspaceId, orderedAt])
  @@index([workspaceId, state, orderedAt])
}

enum OrderState {
  PLACED
  FULFILLED
  CANCELLED
  RETURNED
}

/// سجلّ رسائل التسويق المُرسَلة.
///
/// **لماذا جدول لا حقل تاريخ على المستخدم:** الحملات متعدّدة ومتوازية
/// (تفعيل + دورة التجربة)، وكلّ رسالة تُرسَل **مرّة واحدة فقط** لكلّ
/// مستخدم. حقل «آخر إرسال» واحد كان سيجعل رسالة تكتم أخرى، وإعادة تشغيل
/// الكرون تعيد الإرسال - وهو أسوأ ما يمكن أن يحدث في بريد تسويقي.
model MarketingEmailLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// معرّف الرسالة في الحملة (`trial-d7`, `engage-decisions`, ...)
  messageId String
  sentAt    DateTime @default(now())

  /// الضمانة الفعلية ضدّ التكرار - لا منطق تطبيقي وحده
  @@unique([userId, messageId])
  @@index([userId, sentAt])
}

/// ═══════════════════════════════════════════════════════════════════
/// AdLoop Agent — حاوية المحادثات
///
/// **العقل كان مبنيّاً والذاكرة لا.** مربّع السؤال في كلّ صفحة يسأل
/// ويُجيب اليوم إجابةً كاملةً بجدولها ومؤشّراتها، ثمّ **يُنسى الجواب**
/// عند أوّل تنقّل - فلا يُراجَع، ولا يُبنى عليه سؤالٌ ثانٍ.
///
/// هذان الجدولان هما الذاكرة: كلّ سؤال يُحفظ في محادثة، والمحادثة
/// تُفتَح لاحقاً وتُكمَّل. مربّع السؤال يصير **مدخلاً** إلى القسم لا
/// بديلاً عنه.
/// ═══════════════════════════════════════════════════════════════════
model AgentChat {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// المالك - الملكيّة تُتحقَّق على المستخدم لا على المساحة وحدها
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// عنوان المحادثة = أوّل سؤال مقصوصاً. لا نداء نموذج لتسميتها:
  /// عنوانٌ مولَّد يكلّف توكناً في كلّ محادثة مقابل سطرٍ يُقرأ مرّة.
  title       String
  createdAt   DateTime       @default(now())
  /// يُحدَّث مع كلّ رسالة - الترتيب بالأحدث نشاطاً لا بالأقدم إنشاءً
  updatedAt   DateTime       @updatedAt
  messages    AgentMessage[]

  @@index([workspaceId, updatedAt])
  @@index([userId])
}

model AgentMessage {
  id        String    @id @default(cuid())
  chatId    String
  chat      AgentChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// "user" أو "assistant"
  role      String
  /// نصّ Markdown كما وُلِّد - العرض يفسّره، والتخزين لا يفسّره
  content   String    @db.Text
  createdAt DateTime  @default(now())

  // ═══ حقولُ التقييم - كلُّها على رسالة المساعد وحدها ═══
  //
  // قراءةُ الإجابة وحدها لا تكفي للحكم عليها. إجابةٌ ضعيفة على مساحةٍ
  // بياناتُها فارغة عيبٌ في البيانات لا في المساعد، وإصلاحُ المساعد
  // حينها إصلاحٌ للشيء الخطأ. والحقولُ دي هي الفرق بين «الإجابة وحشة»
  // و«نعرف وحشة ليه».

  /// حكمُ العميل نفسه: ‎1‎ أو ‎-1‎ أو `null` (لم يقيّم).
  /// أصدقُ إشارةٍ عندنا وأرخصُها - مستخدمٌ حقيقيّ على إجابةٍ حقيقية.
  rating       Int?
  /// حكمُ المالك عند المراجعة: GOOD | WRONG_NUMBER | HALLUCINATED |
  /// SHALLOW | IGNORED_DATA | TOO_LONG. نصٌّ لا enum عمداً: القائمة
  /// هتتغيّر مع كلّ جولة تحسين، وترحيلُ enum لإضافة وسمٍ تكلفةٌ بلا مقابل.
  verdict      String?
  reviewNote   String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?

  /// أداءٌ وتكلفة - بيفرّقوا بين «إجابة وحشة» و«إجابة غالية».
  latencyMs    Int?
  inputTokens  Int?
  outputTokens Int?

  /// نسخةُ التعليمات اللي أنتجت الإجابة. **من غيرها مافيش «قبل وبعد»**:
  /// أيّ تحسين بيبقى إحساساً لا قياساً، لأنّ إجاباتِ نسختين مختلفتين
  /// بتتخلط في جدولٍ واحد.
  promptVersion  String?
  /// إيه اللي كان متاحاً للمساعد وقتها (عدد الحملات، وجود تحقّق، طول
  /// التاريخ). بيمنع أخطر خطأ في المراجعة: إصلاحُ المساعد بينما العطب
  /// في البيانات اللي وصلته.
  contextSummary Json?

  @@index([chatId, createdAt])
  /// طابورُ المراجعة: غيرُ المراجَع أوّلاً، والأحدث فالأقدم.
  @@index([role, reviewedAt, createdAt])
  /// كلُّ ما قيّمه العملاء - أسرعُ طريقٍ للعيّنة اللي فيها مشكلة.
  @@index([rating])
}

/// 🔴🔴🔴 **جدولٌ لا يملكه هذا المشروع - ومُعلَنٌ هنا كي لا يُحذَف.**
///
/// `wa-conversion-tracker` يكتب كليكات الواتساب في **قاعدة البيانات نفسها**
/// (قرارٌ مقصود وموثَّق في `.env.example` عنده)، وينشئ جدوله بـ SQL خام
/// `CREATE TABLE IF NOT EXISTS` لا بـ Prisma. فلا يعرفه مخطَّطُنا.
///
/// و`prisma db push` يعامل كلّ جدولٍ لا يعرفه على أنّه انحرافٌ **فيُسقطه**.
/// أي أنّ كلّ بناءٍ لهذا المشروع كان يحذف جدول الكليكات كاملاً - بصمتٍ ما
/// دام فارغاً، وهو الحال في كلّ مرّة سابقة. ولم يظهر إلّا حين وصل أوّل
/// كليكٍ حقيقيّ فصار الحذف «فقدان بيانات» يستوقف Prisma.
///
/// وأثرُه أكبر من صفٍّ ضائع: هذا الجدول هو ذاكرة «مَن ضغط ومتى ومن أيّ
/// إعلان»، ومنه وحده يعرف `/api/attribution/mark-matched` أيّ حملةٍ
/// يُنسَب إليها التحقّق. بحذفه تصبح كلّ رسالة واتساب تصل بعد النشر
/// **مجهولةَ المصدر** - أي أنّ عمود التحقّق كلّه، وهو جوهر المنتج، كان
/// يُصفَّر عند كلّ نشرة.
///
/// **إعلانُه هنا هو الإصلاح:** يصير Prisma يعرف أنّه جدولٌ مقصود فيتركه.
/// والأعمدة منسوخةٌ حرفياً عن `wa-conversion-tracker/lib/db.ts` - وأيّ
/// اختلافٍ في نوعٍ أو اسم يجعل `db push` **يُعدّل** الجدول بدل أن يتركه،
/// فيُفقد ما فيه. لا يُعدَّل هذا النموذج إلّا مع ذاك الملفّ معاً.
model WaClick {
  code           String    @id
  /// الاسم قديم: يحمل معرّف الكليك من أيّ منصّة (fbclid/ttclid/sc_click_id)
  gclid          String
  platform       String    @default("GOOGLE_ADS")
  siteSourceName String?   @map("site_source_name")
  clientId       String    @map("client_id")
  campaignId     String?   @map("campaign_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  matched        Boolean   @default(false)
  matchedAt      DateTime? @map("matched_at") @db.Timestamptz(6)
  phoneNumber    String?   @map("phone_number")
  sentToGoogle   Boolean   @default(false) @map("sent_to_google")
  ipAddress      String?   @map("ip_address")
  visitorId      String?   @map("visitor_id")
  userAgent      String?   @map("user_agent")

  @@index([visitorId], map: "wa_clicks_visitor_idx")
  @@index([clientId, createdAt(sort: Desc)], map: "wa_clicks_client_created_idx")
  @@map("wa_clicks")
}

/// استهلاك نداءات المنصّات - عملياتٌ لا «مزامنات».
///
/// حصّة جوجل مربوطة بتوكن المطوّر أي بتطبيقنا كلّه (١٥٬٠٠٠ عملية/يوم على
/// Basic)، وحصّة تيك توك بتطبيق المطوّر كذلك: حوضٌ واحد يشرب منه كلّ
/// العملاء. فمساحةٌ بمئتَي حملة ومساحةٌ بخمس ليستا نداءً واحداً، وعدُّ
/// «المزامنات» يقيس الشيء الخطأ ويعطي إحساساً كاذباً بالأمان.
///
/// هذه المرحلة **عدٌّ بلا سقف**: كلّ رقمٍ في جدول التخصيص المقترَح تخمينٌ
/// حتى تُقاس التكلفة الحقيقية للمساحة الواحدة - وهي بين ٢٠ عمليةً و٥٠٠،
/// والفرق بينهما هو الفرق بين ستّمئة مشتركٍ وأربعةٍ وعشرين.
///
/// وحوض المنصّة يُجمع بـSUM على اليوم لا بصفٍّ عامّ موازٍ: الصفّ الموازي
/// يلزم عند الإنفاذ حين يُقرأ مع كلّ نداء، لا عند العدّ حيث يُقرأ مرّةً في
/// التقرير - وبناؤه الآن تعقيدٌ سابقٌ لموجبه.
model PlatformUsage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform    Platform
  /// اليوم بتوقيت UTC - حدود الحصص اليومية عند المنصّات تُحسب به
  day         DateTime  @db.Date
  operations  Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, platform, day])
  @@index([platform, day])
}

/// عميلُ OAuth مسجَّلٌ ديناميكياً (RFC 7591).
///
/// عملاءُ MCP لا يُسجَّلون بيدٍ عندنا: claude.ai وChatGPT وغيرُهما يكتشفون
/// الخادم ثمّ يسجّلون أنفسهم قبل أوّل تفويض. وبدون ذلك يبقى الربط مقصوراً
/// على مَن نضيفه نحن يدوياً - وهو ما يُبقي البابَ مغلقاً أمام الأكثرية.
model McpOAuthClient {
  id               String   @id @default(cuid())
  clientId         String   @unique
  /// مُجزَّأ لا خاماً - كبقيّة أسرارنا
  clientSecretHash String?
  clientName       String
  redirectUris     String[]
  createdAt        DateTime @default(now())

  codes McpAuthCode[]

  @@index([clientId])
}

/// رمزُ تفويضٍ قصير العمر مع تحدّي PKCE.
///
/// OAuth 2.1 يوجب PKCE على كلّ عميل، لا على العامّ منها وحده: بدونه يُعترَض
/// الرمزُ في رحلة إعادة التوجيه فيُستبدَل توكناً كاملاً. ويُخزَّن التحدّي
/// لا المُتحقِّق - فلو سُرّبت القاعدة لم يُغنِ السارقَ شيئاً.
model McpAuthCode {
  id                  String         @id @default(cuid())
  code                String         @unique
  clientId            String
  client              McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String         @default("S256")
  scope               String         @default("mcp:read")
  /// دقيقتان - الرمز يُستبدَل فوراً بعد إعادة التوجيه، وطولُ العمر هنا خطر بلا فائدة
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime       @default(now())

  @@index([code])
  @@index([expiresAt])
}
